<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Order Status | Café</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            min-height: 100vh;
            background:
                linear-gradient(
                    rgba(0, 0, 0, 0.55),
                    rgba(0, 0, 0, 0.65)
                ),
                url("/images/cafe-bg.jpg");

            background-size: cover;
            background-position: center;
            background-attachment: fixed;

            color: #fff;
        }

        .container {
            width: 100%;
            max-width: 900px;
            margin: auto;
            padding: 30px 20px 50px;
        }

        /* =========================
           NAVBAR
        ========================= */

        .navbar {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;

            padding: 18px 30px;

            background: rgba(255, 255, 255, 0.10);
            backdrop-filter: blur(12px);

            border: 1px solid rgba(255, 255, 255, 0.15);

            border-radius: 18px;

            margin-bottom: 30px;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .nav-links {
            display: flex;
            gap: 25px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 15px;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: #f5c77a;
        }

        /* =========================
           HEADER
        ========================= */

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 38px;
            margin-bottom: 8px;
        }

        .header p {
            color: #ddd;
            font-size: 15px;
        }

        /* =========================
           MAIN CARD
        ========================= */

        .order-card {
            background: rgba(255, 255, 255, 0.11);

            backdrop-filter: blur(15px);

            border: 1px solid rgba(255, 255, 255, 0.18);

            border-radius: 25px;

            padding: 30px;

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.35);

            margin-bottom: 25px;
        }

        /* =========================
           ORDER TOP
        ========================= */

        .order-top {
            display: flex;
            justify-content: space-between;
            align-items: center;

            padding-bottom: 20px;

            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        }

        .order-number {
            font-size: 14px;
            color: #ccc;
        }

        .order-number strong {
            color: white;
            font-size: 17px;
        }

        .status-badge {
            padding: 8px 15px;

            border-radius: 50px;

            font-size: 13px;
            font-weight: bold;

            background: #f5c77a;
            color: #2b1a0e;
        }

        /* =========================
           COUNTDOWN
        ========================= */

        .timer-section {
            text-align: center;

            padding: 30px 10px;

            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        }

        .timer-title {
            font-size: 14px;
            color: #ccc;
            margin-bottom: 10px;
        }

        .timer {
            font-size: 50px;
            font-weight: bold;

            color: #f5c77a;

            margin-bottom: 5px;
        }

        .timer-text {
            font-size: 13px;
            color: #bbb;
        }

        /* =========================
           STATUS TRACKER
        ========================= */

        .status-section {
            padding: 35px 5px;
        }

        .status-section h2 {
            text-align: center;

            font-size: 22px;

            margin-bottom: 35px;
        }

        .status-tracker {
            display: flex;
            justify-content: space-between;

            position: relative;

            max-width: 700px;

            margin: auto;
        }

        .status-line {
            position: absolute;

            top: 20px;
            left: 12%;

            width: 76%;

            height: 4px;

            background: rgba(255, 255, 255, 0.18);

            z-index: 0;
        }

        .status-progress {
            position: absolute;

            top: 20px;
            left: 12%;

            height: 4px;

            background: #f5c77a;

            z-index: 1;

            transition: width 0.5s ease;
        }

        .status-item {
            position: relative;

            z-index: 2;

            width: 33.33%;

            text-align: center;
        }

        .status-circle {
            width: 40px;
            height: 40px;

            margin: 0 auto 12px;

            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #555;

            border: 3px solid rgba(255, 255, 255, 0.3);

            font-size: 16px;

            transition: 0.4s;
        }

        .status-item.active .status-circle {
            background: #f5c77a;

            color: #2b1a0e;

            border-color: #f5c77a;

            box-shadow:
                0 0 20px rgba(245, 199, 122, 0.4);
        }

        .status-item.completed .status-circle {
            background: #f5c77a;

            color: #2b1a0e;

            border-color: #f5c77a;
        }

        .status-name {
            font-size: 14px;

            font-weight: bold;

            margin-bottom: 4px;
        }

        .status-description {
            font-size: 11px;

            color: #aaa;

            padding: 0 5px;
        }

        /* =========================
           ORDER DETAILS
        ========================= */

        .details-title {
            font-size: 21px;

            margin-bottom: 20px;
        }

        .order-item {
            display: flex;

            align-items: center;

            gap: 18px;

            padding: 15px;

            background: rgba(255, 255, 255, 0.07);

            border-radius: 15px;

            margin-bottom: 20px;
        }

        .item-image {
            width: 85px;
            height: 85px;

            object-fit: cover;

            border-radius: 12px;

            background: rgba(255, 255, 255, 0.1);
        }

        .item-placeholder {
            width: 85px;
            height: 85px;

            border-radius: 12px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: rgba(255, 255, 255, 0.08);

            font-size: 32px;
        }

        .item-info {
            flex: 1;
        }

        .item-name {
            font-size: 18px;

            font-weight: bold;

            margin-bottom: 7px;
        }

        .item-category {
            font-size: 13px;

            color: #aaa;
        }

        .item-price {
            font-size: 18px;

            font-weight: bold;

            color: #f5c77a;
        }

        /* =========================
           INFORMATION GRID
        ========================= */

        .info-grid {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 15px;
        }

        .info-box {
            background:
                rgba(255, 255, 255, 0.06);

            padding: 18px;

            border-radius: 14px;
        }

        .info-label {
            font-size: 12px;

            color: #aaa;

            margin-bottom: 7px;
        }

        .info-value {
            font-size: 16px;

            font-weight: bold;
        }

        /* =========================
           BUTTONS
        ========================= */

        .buttons {
            display: flex;

            justify-content: center;

            gap: 15px;

            margin-top: 25px;
        }

        .btn {
            padding: 13px 25px;

            border-radius: 10px;

            border: none;

            text-decoration: none;

            font-size: 14px;

            font-weight: bold;

            cursor: pointer;

            transition: 0.3s;
        }

        .btn-primary {
            background: #f5c77a;

            color: #2b1a0e;
        }

        .btn-primary:hover {
            transform: translateY(-2px);

            box-shadow:
                0 8px 20px
                rgba(245, 199, 122, 0.25);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.12);

            color: white;

            border: 1px solid
                rgba(255, 255, 255, 0.2);
        }

        .btn-secondary:hover {
            background:
                rgba(255, 255, 255, 0.18);
        }

        /* =========================
           EMPTY ORDER
        ========================= */

        .empty-order {
            text-align: center;

            padding: 60px 20px;
        }

        .empty-icon {
            font-size: 55px;

            margin-bottom: 20px;
        }

        .empty-order h2 {
            margin-bottom: 10px;
        }

        .empty-order p {
            color: #aaa;

            margin-bottom: 25px;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 700px) {

            .container {
                padding: 15px;
            }

            .navbar {
                padding: 15px;

                flex-direction: column;

                gap: 15px;
            }

            .nav-links {
                gap: 15px;

                flex-wrap: wrap;

                justify-content: center;
            }

            .header h1 {
                font-size: 30px;
            }

            .order-card {
                padding: 20px;
            }

            .order-top {
                gap: 15px;

                align-items: flex-start;

                flex-direction: column;
            }

            .status-tracker {
                max-width: 100%;
            }

            .status-name {
                font-size: 12px;
            }

            .status-description {
                font-size: 9px;
            }

            .status-line,
            .status-progress {
                left: 16%;
                width: 68%;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .order-item {
                align-items: flex-start;
            }

            .item-price {
                font-size: 15px;
            }

            .buttons {
                flex-direction: column;
            }

            .btn {
                text-align: center;
            }
        }
    </style>
</head>


<body>

    <div class="container">


        <!-- =========================
             NAVBAR
        ========================== -->

        <nav class="navbar">

            <div class="logo">
                ☕ CAFÉ
            </div>

            <div class="nav-links">

                <a href="/menu">
                    Menu
                </a>

                <a href="/history">
                    Order History
                </a>

                <a href="/tables">
                    Tables
                </a>

                <a href="/logout">
                    Logout
                </a>

            </div>

        </nav>


        <% if (orderData) { %>


        <!-- =========================
             PAGE HEADER
        ========================== -->

        <div class="header">

            <h1>
                Your Order
            </h1>

            <p>
                Track your order in real time
            </p>

        </div>


        <!-- =========================
             ORDER CARD
        ========================== -->

        <div class="order-card">


            <!-- =========================
                 ORDER TOP
            ========================== -->

            <div class="order-top">

                <div class="order-number">

                    Order ID:

                    <strong>
                        #<%= orderData._id %>
                    </strong>

                </div>


                <div
                    class="status-badge"
                    id="statusBadge"
                >
                    <%= orderData.status || "Received" %>
                </div>

            </div>


            <!-- =========================
                 TIMER
            ========================== -->

            <div class="timer-section">

                <div class="timer-title">
                    Estimated preparation time
                </div>

                <div
                    class="timer"
                    id="timer"
                >
                    --
                </div>

                <div class="timer-text">
                    minutes remaining
                </div>

            </div>


            <!-- =========================
                 STATUS TRACKER
            ========================== -->

            <div class="status-section">

                <h2>
                    Order Progress
                </h2>


                <div class="status-tracker">


                    <div class="status-line"></div>

                    <div
                        class="status-progress"
                        id="statusProgress"
                    ></div>


                    <!-- RECEIVED -->

                    <div
                        class="status-item"
                        id="statusReceived"
                    >

                        <div class="status-circle">
                            ✓
                        </div>

                        <div class="status-name">
                            Received
                        </div>

                        <div class="status-description">
                            Order received
                        </div>

                    </div>


                    <!-- PREPARING -->

                    <div
                        class="status-item"
                        id="statusPreparing"
                    >

                        <div class="status-circle">
                            🍳
                        </div>

                        <div class="status-name">
                            Preparing
                        </div>

                        <div class="status-description">
                            Being prepared
                        </div>

                    </div>


                    <!-- READY -->

                    <div
                        class="status-item"
                        id="statusReady"
                    >

                        <div class="status-circle">
                            ✓
                        </div>

                        <div class="status-name">
                            Ready
                        </div>

                        <div class="status-description">
                            Ready to collect
                        </div>

                    </div>


                </div>

            </div>


            <!-- =========================
                 ORDER DETAILS
            ========================== -->

            <div>

                <h2 class="details-title">
                    Order Summary
                </h2>


                <div class="order-item">


                    <% if (
                        menuItem &&
                        menuItem.image
                    ) { %>

                        <img
                            src="<%= menuItem.image %>"
                            alt="<%= orderData.itemName %>"
                            class="item-image"
                        >

                    <% } else if (
                        orderData.image
                    ) { %>

                        <img
                            src="<%= orderData.image %>"
                            alt="<%= orderData.itemName %>"
                            class="item-image"
                        >

                    <% } else { %>

                        <div class="item-placeholder">
                            ☕
                        </div>

                    <% } %>


                    <div class="item-info">

                        <div class="item-name">

                            <%= orderData.itemName ||
                                "Order Item" %>

                        </div>


                        <% if (
                            menuItem &&
                            menuItem.category
                        ) { %>

                            <div class="item-category">

                                <%= menuItem.category %>

                            </div>

                        <% } %>

                    </div>


                    <div class="item-price">

                        ₹<%= Number(
                            orderData.price || 0
                        ).toFixed(2) %>

                    </div>


                </div>


                <!-- =========================
                     ORDER INFORMATION
                ========================== -->

                <div class="info-grid">


                    <div class="info-box">

                        <div class="info-label">
                            Table Number
                        </div>

                        <div class="info-value">

                            Table
                            <%= orderData.table %>

                        </div>

                    </div>


                    <div class="info-box">

                        <div class="info-label">
                            Order Date
                        </div>

                        <div class="info-value">

                            <%= orderData.date %>

                        </div>

                    </div>


                    <div class="info-box">

                        <div class="info-label">
                            Current Status
                        </div>

                        <div
                            class="info-value"
                            id="currentStatus"
                        >

                            <%= orderData.status ||
                                "Received" %>

                        </div>

                    </div>


                    <div class="info-box">

                        <div class="info-label">
                            Total Amount
                        </div>

                        <div
                            class="info-value"
                            style="color:#f5c77a;"
                        >

                            ₹<%= Number(
                                orderData.price || 0
                            ).toFixed(2) %>

                        </div>

                    </div>


                </div>


            </div>


            <!-- =========================
                 BUTTONS
            ========================== -->

            <div class="buttons">

                <a
                    href="/menu"
                    class="btn btn-primary"
                >
                    Order More
                </a>


                <a
                    href="/history"
                    class="btn btn-secondary"
                >
                    View Order History
                </a>

            </div>


        </div>


        <% } else { %>


        <!-- =========================
             NO ORDER
        ========================== -->

        <div class="order-card">

            <div class="empty-order">

                <div class="empty-icon">
                    ☕
                </div>

                <h2>
                    No Order Found
                </h2>

                <p>
                    We couldn't find an active order.
                </p>

                <a
                    href="/menu"
                    class="btn btn-primary"
                >
                    Browse Menu
                </a>

            </div>

        </div>


        <% } %>


    </div>


    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        /*
         * Current order status
         */

        const orderStatus =
            "<%= orderData ? (orderData.status || 'Received') : 'Received' %>"
            .trim()
            .toLowerCase();


        /*
         * DOM elements
         */

        const received =
            document.getElementById(
                "statusReceived"
            );

        const preparing =
            document.getElementById(
                "statusPreparing"
            );

        const ready =
            document.getElementById(
                "statusReady"
            );

        const progress =
            document.getElementById(
                "statusProgress"
            );

        const timer =
            document.getElementById(
                "timer"
            );

        const statusBadge =
            document.getElementById(
                "statusBadge"
            );

        const currentStatus =
            document.getElementById(
                "currentStatus"
            );


        /*
         * Update order status UI
         */

        function updateStatus(status) {

            status =
                String(status)
                    .toLowerCase()
                    .trim();


            /*
             * Remove previous classes
             */

            if (received) {

                received.classList.remove(
                    "active",
                    "completed"
                );

            }

            if (preparing) {

                preparing.classList.remove(
                    "active",
                    "completed"
                );

            }

            if (ready) {

                ready.classList.remove(
                    "active",
                    "completed"
                );

            }


            /*
             * RECEIVED
             */

            if (
                status === "received" ||
                status === "pending"
            ) {

                received.classList.add(
                    "active"
                );

                if (progress) {

                    progress.style.width =
                        "0%";

                }

            }


            /*
             * PREPARING
             */

            else if (
                status === "preparing" ||
                status === "processing"
            ) {

                received.classList.add(
                    "completed"
                );

                preparing.classList.add(
                    "active"
                );

                if (progress) {

                    progress.style.width =
                        "50%";

                }

            }


            /*
             * READY / COMPLETED
             */

            else if (
                status === "ready" ||
                status === "completed" ||
                status === "complete"
            ) {

                received.classList.add(
                    "completed"
                );

                preparing.classList.add(
                    "completed"
                );

                ready.classList.add(
                    "active"
                );

                if (progress) {

                    progress.style.width =
                        "100%";

                }

            }


            /*
             * Unknown status
             */

            else {

                received.classList.add(
                    "active"
                );

                if (progress) {

                    progress.style.width =
                        "0%";

                }

            }


            /*
             * Update text
             */

            if (currentStatus) {

                currentStatus.textContent =
                    status
                        .charAt(0)
                        .toUpperCase() +
                    status.slice(1);

            }

            if (statusBadge) {

                statusBadge.textContent =
                    status
                        .charAt(0)
                        .toUpperCase() +
                    status.slice(1);

            }

        }


        /*
         * Set initial status
         */

        updateStatus(orderStatus);


        /*
         * =========================
         * COUNTDOWN TIMER
         * =========================
         *
         * Received  -> 8 minutes
         * Preparing -> 5 minutes
         * Ready     -> 0 minutes
         */

        let remainingMinutes = 8;


        if (
            orderStatus === "preparing" ||
            orderStatus === "processing"
        ) {

            remainingMinutes = 5;

        }


        if (
            orderStatus === "ready" ||
            orderStatus === "completed" ||
            orderStatus === "complete"
        ) {

            remainingMinutes = 0;

        }


        /*
         * Display timer
         */

        function displayTimer() {

            if (!timer) {
                return;
            }

            timer.textContent =
                remainingMinutes;

        }


        displayTimer();


        /*
         * Countdown every minute
         */

        const countdown =
            setInterval(
                function () {

                    if (
                        remainingMinutes <= 0
                    ) {

                        clearInterval(
                            countdown
                        );

                        return;

                    }


                    remainingMinutes--;

                    displayTimer();


                },
                60000
            );


    </script>


</body>

</html>