
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Register - Our Cafe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --brown: #684035;
            --dark-brown: #3d241e;
            --light-brown: #c99378;
            --cream: #f8f5f0;
            --white: #ffffff;
            --text: #30231f;
            --gray: #777;
            --border: #ded8d3;
            --error: #c94b4b;
        }

        body {
            font-family: "DM Sans", sans-serif;
            color: var(--text);
            background: var(--cream);
        }

        /* PAGE LAYOUT */
        .register-page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* LEFT IMAGE SLIDER */
        .register-image {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
            color: white;
            background: #2b1813;
            isolation: isolate;
        }

        .slider {
            position: absolute;
            inset: 0;
        }

        .slide {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            opacity: 0;
            transform: scale(1.08);
            transition: opacity 1.2s ease, transform 6s ease;
            z-index: 0;
        }

        .slide.active {
            opacity: 1;
            transform: scale(1);
            z-index: 1;
        }

        .overlay {
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            background: linear-gradient(
                90deg,
                rgba(35, 18, 14, 0.88) 0%,
                rgba(45, 24, 19, 0.67) 48%,
                rgba(35, 18, 14, 0.35) 100%
            );
        }

        .register-image::after {
            content: "";
            position: absolute;
            inset: auto 0 0;
            height: 45%;
            z-index: 2;
            pointer-events: none;
            background: linear-gradient(
                transparent,
                rgba(25, 12, 9, 0.65)
            );
        }

        .image-content {
            position: relative;
            z-index: 4;
            min-height: 100vh;
            padding: 55px 12%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 9px;
            font-family: "Playfair Display", serif;
            font-size: 25px;
            font-weight: 600;
        }

        .brand i {
            color: #d5a48d;
            font-size: 22px;
        }

        .welcome-text {
            margin-bottom: 80px;
            max-width: 620px;
        }

        .welcome-text p {
            font-family: "Playfair Display", serif;
            font-size: 13px;
            letter-spacing: 1.8px;
            color: #d5a48d;
            margin-bottom: 15px;
        }

        .welcome-text h1 {
            font-family: "Playfair Display", serif;
            font-size: clamp(42px, 4vw, 65px);
            line-height: 1.1;
            font-weight: 600;
            margin-bottom: 20px;
            text-shadow: 0 3px 15px rgba(0, 0, 0, 0.35);
        }

        .welcome-text span {
            display: block;
            max-width: 500px;
            color: #eee;
            font-size: 14px;
            line-height: 1.7;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        }

        /* SLIDER CONTROLS */
        .slider-btn {
            position: absolute;
            z-index: 6;
            top: 58%;
            width: 52px;
            height: 52px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            color: white;
            cursor: pointer;
            font-size: 15px;
            transition: 0.3s;
        }

        .slider-btn:hover {
            background: var(--brown);
            transform: scale(1.08);
        }

        .slider-btn:focus-visible,
        .dot:focus-visible {
            outline: 2px solid white;
            outline-offset: 4px;
        }

        .slider-btn.prev {
            left: 35px;
        }

        .slider-btn.next {
            right: 35px;
        }

        .slider-dots {
            position: absolute;
            z-index: 6;
            left: 45px;
            top: 42%;
            display: flex;
            flex-direction: column;
            gap: 11px;
        }

        .dot {
            width: 9px;
            height: 9px;
            padding: 0;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.8);
            background: transparent;
            cursor: pointer;
            transition: 0.35s;
        }

        .dot:hover {
            background: white;
        }

        .dot.active {
            width: 10px;
            height: 10px;
            background: #d5a48d;
            border-color: #d5a48d;
            box-shadow: 0 0 0 4px rgba(213, 164, 141, 0.15);
        }

        /* RIGHT SIDE */
        .register-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .register-container {
            width: 100%;
            max-width: 430px;
        }

        .back-home {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #777;
            text-decoration: none;
            font-size: 13px;
            margin-bottom: 30px;
            transition: 0.3s;
        }

        .back-home:hover {
            color: var(--brown);
        }

        /* HEADER */
        .register-header {
            text-align: center;
            margin-bottom: 26px;
        }

        .register-icon {
            width: 55px;
            height: 55px;
            margin: 0 auto 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #f0e3dc;
            color: var(--brown);
            font-size: 21px;
        }

        .register-header h2 {
            font-family: "Playfair Display", serif;
            font-size: 31px;
            color: var(--dark-brown);
            margin-bottom: 8px;
        }

        .register-header p {
            font-size: 14px;
            color: var(--gray);
            line-height: 1.6;
        }

        /* ROLE TABS */
        .role-tabs {
            display: flex;
            background: #eee5e0;
            border-radius: 8px;
            padding: 4px;
            margin-top: 20px;
            gap: 4px;
        }

        .role-tab {
            flex: 1;
            padding: 11px 8px;
            border: none;
            border-radius: 6px;
            background: transparent;
            color: var(--brown);
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            font-size: 13px;
            font-family: inherit;
        }

        .role-tab.active {
            background: var(--dark-brown);
            color: white;
        }

        .role-tab:focus-visible {
            outline: 2px solid var(--brown);
            outline-offset: 2px;
        }

        /* FORM */
        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text);
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper > i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9a8f89;
            font-size: 14px;
            pointer-events: none;
        }

        .input-wrapper input {
            width: 100%;
            height: 48px;
            padding: 0 45px 0 44px;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: white;
            color: var(--text);
            font-family: "DM Sans", sans-serif;
            font-size: 14px;
            outline: none;
            transition: 0.25s;
        }

        .input-wrapper input::placeholder {
            color: #aaa;
        }

        .input-wrapper input:focus {
            border-color: var(--brown);
            box-shadow: 0 0 0 3px rgba(104, 64, 53, 0.08);
        }

        .password-toggle {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #999;
            cursor: pointer;
            font-size: 14px;
            padding: 5px;
        }

        .password-toggle:hover {
            color: var(--brown);
        }

        .message {
            min-height: 20px;
            font-size: 12px;
            margin-bottom: 10px;
            text-align: center;
            line-height: 1.5;
        }

        .error-message {
            color: var(--error);
        }

        .success-message {
            color: #278044;
        }

        /* REGISTER BUTTON */
        .register-button {
            width: 100%;
            min-height: 50px;
            border: none;
            border-radius: 6px;
            background: var(--dark-brown);
            color: white;
            cursor: pointer;
            font-family: "DM Sans", sans-serif;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            transition: 0.3s;
            margin-top: 10px;
        }

        .register-button:hover {
            background: var(--brown);
            transform: translateY(-1px);
        }

        .register-button:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

        .login-text {
            text-align: center;
            color: #777;
            font-size: 13px;
            margin-top: 24px;
        }

        .login-text a {
            color: var(--brown);
            font-weight: 600;
            text-decoration: none;
        }

        .login-text a:hover {
            text-decoration: underline;
        }

        /* RESPONSIVE */
        @media (max-width: 1100px) {
            .image-content {
                padding-left: 10%;
                padding-right: 10%;
            }

            .slider-dots {
                left: 20px;
            }

            .slider-btn.prev {
                left: 20px;
            }

            .slider-btn.next {
                right: 20px;
            }

            .register-section {
                padding: 30px;
            }
        }

        @media (max-width: 850px) {
            .register-page {
                grid-template-columns: 1fr;
            }

            .register-image {
                display: none;
            }

            .register-section {
                padding: 35px 25px;
            }

            .register-container {
                max-width: 450px;
            }
        }

        @media (max-width: 450px) {
            .register-section {
                padding: 25px 20px;
            }

            .back-home {
                margin-bottom: 25px;
            }

            .register-header h2 {
                font-size: 27px;
            }

            .role-tab {
                font-size: 12px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .slide {
                transition: opacity 0.3s ease;
                transform: none;
            }

            .register-button,
            .slider-btn {
                transition: none;
            }
        }
    </style>
</head>

<body>

<main class="register-page">

    <!-- LEFT SIDE: IMAGE SLIDER -->
    <section class="register-image" aria-label="Our Cafe gallery">

        <div class="slider">

            <div
                class="slide active"
                role="img"
                aria-label="Coffee served in a cafe"
                style="background-image: url('https://images.unsplash.com/photo-1445116572660-236099ec97a0?auto=format&fit=crop&w=1400&q=85');">
            </div>

            <div
                class="slide"
                role="img"
                aria-label="Freshly brewed coffee"
                style="background-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1400&q=85');">
            </div>

            <div
                class="slide"
                role="img"
                aria-label="Coffee and cafe atmosphere"
                style="background-image: url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=1400&q=85');">
            </div>

            <div
                class="slide"
                role="img"
                aria-label="Coffee and pastries"
                style="background-image: url('https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1400&q=85');">
            </div>

            <div
                class="slide"
                role="img"
                aria-label="Cafe food and dining"
                style="background-image: url('https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1400&q=85');">
            </div>

        </div>

        <div class="overlay"></div>

        <!-- FIXED TEXT -->
        <div class="image-content">
            
            <div class="brand">
                <a href="/" style="text-decoration: none; color: inherit;">
                <i class="fa-solid fa-mug-hot"></i>
                <span>Our Cafe</span>
                </a>
            </div>
           

            <div class="welcome-text">
                <p>JOIN OUR COMMUNITY</p>

                <h1>
                    Start Your<br>
                    Journey With Us.
                </h1>

                <span>
                    Create an account to unlock exclusive rewards,
                    faster table reservations, and seamless online ordering.
                </span>
            </div>

        </div>

        <!-- PREVIOUS BUTTON -->
        <button
            class="slider-btn prev"
            id="prevSlide"
            type="button"
            aria-label="Previous image">
            <i class="fa-solid fa-arrow-left"></i>
        </button>

        <!-- NEXT BUTTON -->
        <button
            class="slider-btn next"
            id="nextSlide"
            type="button"
            aria-label="Next image">
            <i class="fa-solid fa-arrow-right"></i>
        </button>

        <!-- SLIDER DOTS -->
        <div class="slider-dots" id="sliderDots" aria-label="Choose an image">

            <button class="dot active" type="button" data-slide="0" aria-label="Image 1"></button>

            <button class="dot" type="button" data-slide="1" aria-label="Image 2"></button>

            <button class="dot" type="button" data-slide="2" aria-label="Image 3"></button>

            <button class="dot" type="button" data-slide="3" aria-label="Image 4"></button>

            <button class="dot" type="button" data-slide="4" aria-label="Image 5"></button>

        </div>

    </section>

    <!-- RIGHT SIDE: REGISTRATION FORM -->
    <section class="register-section">

        <div class="register-container">

            <a href="/" class="back-home">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Home
            </a>

            <div class="register-header">

                <div class="register-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>

                <h2 id="headerTitle">Create Account</h2>

                <p id="headerSubtitle">
                    Join Our Cafe for fast ordering and perks
                </p>

                <!-- ROLE SWITCHER -->
                <div class="role-tabs">

                    <button
                        type="button"
                        id="tabCustomer"
                        class="role-tab active"
                        aria-pressed="true">

                        <i class="fa-solid fa-user-large"></i>
                        Customer
                    </button>

                    <button
                        type="button"
                        id="tabStaff"
                        class="role-tab"
                        aria-pressed="false">

                        <i class="fa-solid fa-id-badge"></i>
                        Cafe Staff
                    </button>

                </div>

            </div>

            <!-- REGISTRATION FORM -->
            <form id="registerForm" action="/register" method="POST">

                <!-- Selected role -->
                <input type="hidden" name="role" id="roleInput" value="customer">

                <!-- FULL NAME -->
                <div class="form-group">

                    <label for="fullName">Full Name</label>

                    <div class="input-wrapper">

                        <i class="fa-regular fa-user"></i>

                        <input
                            type="text"
                            id="fullName"
                            name="name"
                            placeholder="Enter your full name"
                            autocomplete="name"
                            minlength="2"
                            maxlength="100"
                            required>

                    </div>

                </div>

                <!-- EMAIL -->
                <div class="form-group">

                    <label for="email" id="emailLabel">
                        Email Address
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-regular fa-envelope"></i>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            autocomplete="email"
                            required>

                    </div>

                </div>

                <!-- PASSWORD -->
                <div class="form-group">

                    <label for="password">Password</label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-lock"></i>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Create a password"
                            autocomplete="new-password"
                            minlength="8"
                            required>

                        <button
                            type="button"
                            class="password-toggle"
                            id="passwordToggle"
                            aria-label="Show password"
                            aria-pressed="false">

                            <i class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                </div>

                <!-- ERROR / STATUS MESSAGE -->
                <div
                    class="message error-message"
                    id="errorMessage"
                    role="status"
                    aria-live="polite">
                </div>

                <!-- REGISTER BUTTON -->
                <button
                    type="submit"
                    class="register-button"
                    id="registerButton">

                    <span id="buttonText">
                        Create Customer Account
                    </span>

                    <i
                        class="fa-solid fa-arrow-right"
                        id="buttonIcon">
                    </i>

                </button>

            </form>

            <!-- LOGIN LINK -->
            <div class="login-text">
                Already have an account?
                <a href="/login">Sign In</a>
            </div>

        </div>

    </section>

</main>

<script>
    "use strict";

    /* =================================
       CAFE IMAGE SLIDER
    ================================= */

    const slides = document.querySelectorAll(".slide");
    const dots = document.querySelectorAll(".dot");

    const prevButton = document.getElementById("prevSlide");
    const nextButton = document.getElementById("nextSlide");

    let currentSlide = 0;
    let sliderInterval = null;

    const SLIDE_DURATION = 5000;

    function showSlide(index) {
        if (slides.length === 0) return;

        // Support forward and backward navigation
        currentSlide = (index + slides.length) % slides.length;

        slides.forEach((slide, i) => {
            slide.classList.toggle("active", i === currentSlide);
        });

        dots.forEach((dot, i) => {
            dot.classList.toggle("active", i === currentSlide);

            if (i === currentSlide) {
                dot.setAttribute("aria-current", "true");
            } else {
                dot.removeAttribute("aria-current");
            }
        });
    }

    function startSlider() {
        clearInterval(sliderInterval);
        sliderInterval = null;

        if (slides.length > 1) {
            sliderInterval = setInterval(() => {
                showSlide(currentSlide + 1);
            }, SLIDE_DURATION);
        }
    }

    function nextSlide() {
        showSlide(currentSlide + 1);
        startSlider();
    }

    function previousSlide() {
        showSlide(currentSlide - 1);
        startSlider();
    }

    if (nextButton) {
        nextButton.addEventListener("click", nextSlide);
    }

    if (prevButton) {
        prevButton.addEventListener("click", previousSlide);
    }

    dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
            showSlide(index);
            startSlider();
        });
    });

    // Pause automatic transitions when the tab is hidden
    document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
            clearInterval(sliderInterval);
            sliderInterval = null;
        } else {
            startSlider();
        }
    });

    // Initialize the first slide
    showSlide(0);
    startSlider();


    /* =================================
       CUSTOMER / STAFF ROLE SWITCHER
    ================================= */

    const tabCustomer = document.getElementById("tabCustomer");
    const tabStaff = document.getElementById("tabStaff");

    const headerTitle = document.getElementById("headerTitle");
    const headerSubtitle = document.getElementById("headerSubtitle");

    const emailLabel = document.getElementById("emailLabel");
    const emailInput = document.getElementById("email");

    const roleInput = document.getElementById("roleInput");
    const buttonText = document.getElementById("buttonText");

    let currentRole = "customer";

    function setRole(role) {
        currentRole = role;
        roleInput.value = role;

        const isCustomer = role === "customer";

        tabCustomer.classList.toggle("active", isCustomer);
        tabStaff.classList.toggle("active", !isCustomer);

        tabCustomer.setAttribute("aria-pressed", String(isCustomer));
        tabStaff.setAttribute("aria-pressed", String(!isCustomer));

        if (isCustomer) {
            headerTitle.textContent = "Create Account";
            headerSubtitle.textContent =
                "Join Our Cafe for fast ordering and perks";

            emailLabel.textContent = "Email Address";
            emailInput.placeholder = "Enter your email";
            buttonText.textContent = "Create Customer Account";
        } else {
            headerTitle.textContent = "Staff Registration";
            headerSubtitle.textContent =
                "Register a new staff profile for management access";

            emailLabel.textContent = "Staff Work Email";
            emailInput.placeholder = "Enter your staff email";
            buttonText.textContent = "Register Staff Account";
        }

        clearMessage();
    }

    tabCustomer.addEventListener("click", () => {
        setRole("customer");
    });

    tabStaff.addEventListener("click", () => {
        setRole("staff");
    });


    /* =================================
       SHOW / HIDE PASSWORD
    ================================= */

    const passwordInput = document.getElementById("password");
    const passwordToggle = document.getElementById("passwordToggle");

    passwordToggle.addEventListener("click", () => {
        const shouldShow = passwordInput.type === "password";

        passwordInput.type = shouldShow ? "text" : "password";

        passwordToggle.innerHTML = shouldShow
            ? '<i class="fa-regular fa-eye-slash"></i>'
            : '<i class="fa-regular fa-eye"></i>';

        passwordToggle.setAttribute(
            "aria-label",
            shouldShow ? "Hide password" : "Show password"
        );

        passwordToggle.setAttribute(
            "aria-pressed",
            String(shouldShow)
        );
    });


    /* =================================
       FORM VALIDATION
    ================================= */

    const registerForm = document.getElementById("registerForm");
    const errorMessage = document.getElementById("errorMessage");
    const registerButton = document.getElementById("registerButton");
    const buttonIcon = document.getElementById("buttonIcon");

    function clearMessage() {
        errorMessage.textContent = "";
        errorMessage.className = "message error-message";
    }

    registerForm.addEventListener("submit", (event) => {
        clearMessage();

        const fullName = document.getElementById("fullName").value.trim();
        const email = emailInput.value.trim();
        const password = passwordInput.value;

        if (fullName.length < 2) {
            event.preventDefault();
            errorMessage.textContent =
                "Please enter your full name.";
            return;
        }

        if (!email) {
            event.preventDefault();
            errorMessage.textContent =
                "Please enter your email address.";
            return;
        }

        if (password.length < 8) {
            event.preventDefault();
            errorMessage.textContent =
                "Password must contain at least 8 characters.";
            return;
        }

        // Allow the browser to submit the form to /register.
        // Do not simulate a successful account creation here.
        registerButton.disabled = true;
        buttonText.textContent = "Creating Account...";
        buttonIcon.className = "fa-solid fa-spinner fa-spin";
    });

</script>

</body>
</html>
