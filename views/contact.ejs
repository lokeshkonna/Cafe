
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#3d241e">

    <title>Contact Us - Our Cafe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --brown: #684035;
            --dark-brown: #3d241e;
            --cream: #f8f5f0;
            --white: #ffffff;
            --muted: #777777;
            --border: #ded8d3;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "DM Sans", sans-serif;
            background: var(--cream);
            color: var(--dark-brown);
        }

        a {
            color: inherit;
        }

        /* Top bar */
        .top-bar {
            min-height: 48px;
            padding: 0 7%;
            background: #5a352b;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .top-left span {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: 12px;
        }

        .social-icons,
        .top-right {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .social-icons a,
        .top-right a {
            color: white;
            text-decoration: none;
            transition: color 0.3s;
        }

        .social-icons a:hover,
        .top-right a:hover {
            color: #e3b69c;
        }

        .social-icons i,
        .top-right i {
            font-size: 15px;
        }

        .login-top {
            padding: 16px 20px;
            background: #3d241e;
            font-size: 12px;
            font-weight: 600;
        }

        /* Navigation */
        .navbar {
            min-height: 75px;
            padding: 12px 7%;
            background: var(--dark-brown);
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            position: relative;
            z-index: 100;
        }

        .logo {
            color: white;
            text-decoration: none;
            font-family: "Playfair Display", serif;
            font-size: 25px;
            font-weight: 700;
            white-space: nowrap;
        }

        .logo i {
            color: #c18c70;
            margin-right: 7px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
            list-style: none;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-family: "Playfair Display", serif;
            font-size: 15px;
            transition: color 0.3s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #d5a48d;
        }

        .nav-contact {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
            white-space: nowrap;
        }

        .nav-contact i {
            color: #d5a48d;
        }

        .nav-contact a {
            color: white;
            text-decoration: none;
            font-size: 13px;
        }

        .menu-btn {
            display: none;
            border: 0;
            background: transparent;
            color: white;
            font-size: 24px;
            cursor: pointer;
        }

        /* Contact section */
        .contact-section {
            padding: 85px 7%;
            min-height: 80vh;
            background: var(--cream);
        }

        .section-heading {
            max-width: 720px;
            margin: 0 auto;
            text-align: center;
        }

        .subtitle {
            margin-bottom: 12px;
            color: var(--brown);
            font-family: "Playfair Display", serif;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 3px;
        }

        .section-heading h1 {
            font-family: "Playfair Display", serif;
            font-size: clamp(30px, 4vw, 45px);
            line-height: 1.2;
            color: var(--dark-brown);
        }

        .section-heading > p:last-child {
            max-width: 560px;
            margin: 16px auto 0;
            color: var(--muted);
            font-size: 15px;
            line-height: 1.8;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 30px;
            max-width: 1100px;
            margin: 45px auto 0;
        }

        .contact-info-card,
        .contact-form-card {
            padding: 35px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 10px 35px rgba(61, 36, 30, 0.05);
        }

        .contact-info-card h2,
        .contact-form-card h2 {
            margin-bottom: 12px;
            font-family: "Playfair Display", serif;
            font-size: 25px;
        }

        .card-description {
            margin-bottom: 28px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.7;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 17px;
            margin-top: 25px;
        }

        .info-item > i {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            background: #f0e5de;
            color: var(--brown);
            border-radius: 50%;
            font-size: 18px;
        }

        .info-item h3 {
            margin: 3px 0 7px;
            font-size: 15px;
        }

        .info-item p,
        .info-item a {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .info-item a {
            text-decoration: none;
        }

        .info-item a:hover {
            color: var(--brown);
        }

        /* Contact form */
        .form-group {
            margin-bottom: 21px;
        }

        .form-group label {
            display: block;
            margin-bottom: 9px;
            color: var(--dark-brown);
            font-size: 14px;
            font-weight: 700;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: #fffdfb;
            color: var(--dark-brown);
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: border-color 0.3s, box-shadow 0.3s;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: var(--brown);
            box-shadow: 0 0 0 3px rgba(104, 64, 53, 0.1);
        }

        .form-group textarea {
            min-height: 130px;
            resize: vertical;
        }

        .submit-btn {
            width: 100%;
            padding: 15px 22px;
            border: none;
            border-radius: 8px;
            background: var(--dark-brown);
            color: white;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.3s, transform 0.3s;
        }

        .submit-btn:hover {
            background: var(--brown);
            transform: translateY(-2px);
        }

        .submit-btn:disabled {
            opacity: 0.7;
            cursor: wait;
            transform: none;
        }

        /* Animated toast notification */
        .toast {
            position: fixed;
            top: 24px;
            right: 24px;
            z-index: 9999;
            display: flex;
            align-items: flex-start;
            gap: 13px;
            width: min(390px, calc(100vw - 30px));
            padding: 19px 40px 24px 17px;
            overflow: hidden;
            border: 1px solid #eee8e3;
            border-left: 5px solid #22a06b;
            border-radius: 13px;
            background: #ffffff;
            color: #252525;
            box-shadow: 0 14px 45px rgba(0, 0, 0, 0.18);

            opacity: 0;
            visibility: hidden;
            transform: translateX(calc(100% + 30px));
            transition:
                transform 0.45s cubic-bezier(.2, .8, .2, 1),
                opacity 0.35s ease,
                visibility 0.35s;
        }

        .toast.show {
            opacity: 1;
            visibility: visible;
            transform: translateX(0);
        }

        .toast.error {
            border-left-color: #e5484d;
        }

        .toast-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #dcfce7;
            color: #15803d;
            font-size: 20px;
            font-weight: 700;
        }

        .toast.error .toast-icon {
            background: #fee2e2;
            color: #dc2626;
        }

        .toast-content {
            flex: 1;
            padding-top: 1px;
        }

        .toast-content h4 {
            margin: 2px 0 5px;
            font-size: 15px;
            font-weight: 700;
        }

        .toast-content p {
            color: #666;
            font-size: 13px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .toast-close {
            position: absolute;
            top: 7px;
            right: 11px;
            padding: 2px 5px;
            border: 0;
            background: transparent;
            color: #888;
            font-size: 24px;
            cursor: pointer;
        }

        .toast-close:hover {
            color: #222;
        }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: #22a06b;
            transform: scaleX(1);
            transform-origin: left;
        }

        .toast.error .toast-progress {
            background: #e5484d;
        }

        .toast.show .toast-progress {
            animation: toastTimer 4.5s linear forwards;
        }

        @keyframes toastTimer {
            to {
                transform: scaleX(0);
            }
        }

        /* Footer */
        .footer {
            padding: 23px 7%;
            background: var(--dark-brown);
            color: #e8dcd5;
            text-align: center;
            font-size: 13px;
        }

        /* Responsive navigation and layout */
        @media (max-width: 1100px) {
            .navbar {
                padding-left: 4%;
                padding-right: 4%;
                gap: 15px;
            }

            .nav-links {
                gap: 15px;
            }

            .nav-links a {
                font-size: 14px;
            }

            .nav-contact a {
                font-size: 12px;
            }

            .top-bar {
                padding: 0 4%;
            }
        }

        @media (max-width: 850px) {
            .menu-btn {
                display: block;
                margin-left: auto;
            }

            .nav-contact {
                display: none;
            }

            .nav-links {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                display: none;
                flex-direction: column;
                align-items: stretch;
                gap: 0;
                padding: 10px 5% 18px;
                background: var(--dark-brown);
                box-shadow: 0 12px 18px rgba(0, 0, 0, 0.15);
            }

            .nav-links.open {
                display: flex;
            }

            .nav-links li a {
                display: block;
                padding: 12px 0;
                font-size: 16px;
            }

            .contact-grid {
                grid-template-columns: 1fr;
                max-width: 650px;
            }

            .contact-section {
                padding: 65px 5%;
            }
        }

        @media (max-width: 560px) {
            .top-bar {
                justify-content: center;
                padding: 10px 15px;
            }

            .top-left span {
                font-size: 10px;
                text-align: center;
            }

            .social-icons,
            .top-right {
                display: none;
            }

            .navbar {
                min-height: 68px;
                padding: 12px 5%;
            }

            .logo {
                font-size: 22px;
            }

            .contact-section {
                padding: 48px 18px;
            }

            .contact-grid {
                margin-top: 30px;
                gap: 20px;
            }

            .contact-info-card,
            .contact-form-card {
                padding: 24px 20px;
            }

            .section-heading h1 {
                font-size: 32px;
            }

            .section-heading > p:last-child {
                font-size: 14px;
            }

            .info-item {
                gap: 13px;
            }

            .info-item > i {
                width: 42px;
                height: 42px;
                font-size: 16px;
            }

            .toast {
                top: 15px;
                right: 15px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>

<body>

    <!-- Top bar -->
    <div class="top-bar">
        <div class="top-left">
            <span>
                <i class="fa-regular fa-clock"></i>
                Mon - Fri: 9:00 - 19:00 / Closed on Weekends
            </span>
        </div>

        <div class="social-icons">
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <i class="fa-brands fa-facebook-f"></i>
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <i class="fa-brands fa-instagram"></i>
            </a>
            <a href="https://x.com" target="_blank" rel="noopener noreferrer" aria-label="X">
                <i class="fa-brands fa-x-twitter"></i>
            </a>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                <i class="fa-brands fa-youtube"></i>
            </a>
        </div>

        <div class="top-right">
            <a href="/menu" title="Menu">
                <i class="fa-solid fa-cart-shopping"></i>
            </a>
            <a href="/profile" title="Profile">
                <i class="fa-regular fa-user"></i>
            </a>
            <a href="/login" class="login-top">LOGIN OR SIGN UP</a>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="navbar" aria-label="Main navigation">
        <a href="/index" class="logo">
            <i class="fa-solid fa-mug-hot"></i>Our Cafe
        </a>

        <button
            type="button"
            class="menu-btn"
            id="menuBtn"
            aria-label="Toggle navigation"
            aria-expanded="false"
            aria-controls="navLinks">
            <i class="fa-solid fa-bars"></i>
        </button>

        <ul class="nav-links" id="navLinks">
            <li><a href="/index">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/menu">Menu</a></li>
            <li><a href="/tables">Book Table</a></li>
            <li><a href="/order-status">Order Status</a></li>
            <li><a href="/contact" class="active" aria-current="page">Contact</a></li>
        </ul>

        <div class="nav-contact">
            <i class="fa-solid fa-phone-volume"></i>
            <a href="tel:+917052101786">+91 705 210-1786</a>
        </div>
    </nav>

    <!-- Contact section -->
    <main>
        <section class="contact-section">
            <div class="section-heading">
                <p class="subtitle">GET IN TOUCH</p>
                <h1>We'd Love to Hear From You</h1>
                <p>
                    Have a question, suggestion, or feedback?
                    Send us a message. We'd be happy to hear from you.
                </p>
            </div>

            <div class="contact-grid">

                <!-- Contact information -->
                <div class="contact-info-card">
                    <h2>Contact Information</h2>
                    <p class="card-description">
                        Get in touch with us using the information below.
                        We're always happy to help.
                    </p>

                    <div class="info-item">
                        <i class="fa-solid fa-location-dot"></i>
                      <a href="https://maps.google.com/?q=123+Coffee+Avenue,+Artisanal+District" target="_blank" rel="noopener noreferrer">
                            <div>
                                <h3>Our Location</h3>
                                <p>123 Coffee Avenue, Artisanal District</p>
                            </div>
                        </a>
                    </div>

                    <div class="info-item">
                        <i class="fa-solid fa-phone"></i>
                        <div>
                            
                            <h3>Phone Number</h3>
                            <p>
                                <a href="tel:+917052101786">+91 705 210-1786</a>
                            </p>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="fa-solid fa-envelope"></i>
                        <div>
                            <h3>Email Address</h3>
                            <p>
                                <a href="mailto:contact@ourcafe.com">contact@ourcafe.com</a>
                            </p>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="fa-regular fa-clock"></i>
                        <div>
                            <h3>Opening Hours</h3>
                            <p>Monday - Friday: 9:00 AM - 7:00 PM</p>
                            <p>Saturday - Sunday: Closed</p>
                        </div>
                    </div>
                </div>

                <!-- Contact form -->
                <div class="contact-form-card">
                    <h2>Send Us a Message</h2>
                    <p class="card-description">
                        Complete the form below and we'll be glad to assist you.
                    </p>

                    <form id="contactForm" action="/contact" method="POST" novalidate>
                        <div class="form-group">
                            <label for="name">Your Name</label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="John Doe"
                                autocomplete="name"
                                maxlength="100"
                                required>
                        </div>

                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="john@example.com"
                                autocomplete="email"
                                maxlength="254"
                                required>
                        </div>

                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea
                                id="message"
                                name="message"
                                rows="5"
                                placeholder="How can we help you?"
                                maxlength="3000"
                                required></textarea>
                        </div>

                        <button type="submit" class="submit-btn" id="submitBtn">
                            <i class="fa-regular fa-paper-plane"></i>
                            Send Message
                        </button>
                    </form>
                </div>

            </div>
        </section>
    </main>

    <!-- Animated toast: placed before the JavaScript -->
    <div
        id="toast"
        class="toast"
        role="status"
        aria-live="polite"
        aria-atomic="true">

        <div class="toast-icon" id="toastIcon" aria-hidden="true">✓</div>

        <div class="toast-content">
            <h4 id="toastTitle">Success!</h4>
            <p id="toastMessage">Your message has been sent.</p>
        </div>

        <button
            type="button"
            class="toast-close"
            id="toastClose"
            aria-label="Close notification">
            &times;
        </button>

        <div class="toast-progress" id="toastProgress"></div>
    </div>

    <footer class="footer">
        <p>&copy; <span id="year"></span> Our Cafe. All rights reserved.</p>
    </footer>

    <script>
        "use strict";

        // Mobile navigation
        const menuBtn = document.getElementById("menuBtn");
        const navLinks = document.getElementById("navLinks");

        menuBtn.addEventListener("click", function () {
            const isOpen = navLinks.classList.toggle("open");

            menuBtn.setAttribute("aria-expanded", String(isOpen));

            menuBtn.innerHTML = isOpen
                ? '<i class="fa-solid fa-xmark"></i>'
                : '<i class="fa-solid fa-bars"></i>';
        });

        navLinks.querySelectorAll("a").forEach(function (link) {
            link.addEventListener("click", function () {
                navLinks.classList.remove("open");
                menuBtn.setAttribute("aria-expanded", "false");
                menuBtn.innerHTML = '<i class="fa-solid fa-bars"></i>';
            });
        });

        // Footer year
        document.getElementById("year").textContent =
            new Date().getFullYear();

        // Toast notification elements
        const toast = document.getElementById("toast");
        const toastIcon = document.getElementById("toastIcon");
        const toastTitle = document.getElementById("toastTitle");
        const toastMessage = document.getElementById("toastMessage");
        const toastProgress = document.getElementById("toastProgress");
        const toastClose = document.getElementById("toastClose");

        let toastTimeout;

        function showToast(type, title, message) {
            clearTimeout(toastTimeout);

            toast.classList.remove("show", "error");

            toastIcon.textContent = type === "success" ? "✓" : "!";
            toastTitle.textContent = title;
            toastMessage.textContent = message;

            if (type === "error") {
                toast.classList.add("error");
            }

            // Restart the progress animation
            toastProgress.style.animation = "none";
            void toastProgress.offsetWidth;
            toastProgress.style.animation = "";

            // Restart the entrance animation
            void toast.offsetWidth;
            toast.classList.add("show");

            toastTimeout = setTimeout(function () {
                hideToast();
            }, 4500);
        }

        function hideToast() {
            toast.classList.remove("show");
            clearTimeout(toastTimeout);
        }

        toastClose.addEventListener("click", hideToast);

        // Contact form validation and submission
        const form = document.getElementById("contactForm");
        const nameInput = document.getElementById("name");
        const emailInput = document.getElementById("email");
        const messageInput = document.getElementById("message");
        const submitBtn = document.getElementById("submitBtn");

        form.addEventListener("submit", function (event) {
            event.preventDefault();

            const name = nameInput.value.trim();
            const email = emailInput.value.trim();
            const message = messageInput.value.trim();

            if (!name || !email || !message) {
                showToast(
                    "error",
                    "Missing Information",
                    "Please fill in your name, email address, and message."
                );
                return;
            }

            if (!emailInput.checkValidity()) {
                showToast(
                    "error",
                    "Invalid Email",
                    "Please enter a valid email address."
                );
                emailInput.focus();
                return;
            }

            // Do not show a false success message or submit twice.
            submitBtn.disabled = true;
            submitBtn.innerHTML =
                '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';

            showToast(
                "success",
                "Submitting Message",
                "Your form is being submitted. Please wait..."
            );

            // Submit to the configured server endpoint.
            // The backend must handle POST /contact.
            setTimeout(function () {
                HTMLFormElement.prototype.submit.call(form);
            }, 500);
        });
    </script>

</body>
</html>
