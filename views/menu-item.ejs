<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Foodora | Food Ordering</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<style>
:root{
    --brown:#6a4034;
    --dark-brown:#40251f;
    --cream:#f8f5f0;
    --white:#ffffff;
    --text:#59443c;
    --muted:#8b7b73;
    --border:#e6dcd5;
    --soft-brown:#f0e5de;
    --shadow:0 18px 45px rgba(64,37,31,.09);
    --primary:var(--brown);
    --primary-dark:var(--dark-brown);
    --primary-light:var(--soft-brown);
    --accent:var(--brown);
    --danger:var(--dark-brown);
    --dark:var(--dark-brown);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"DM Sans",sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--cream);
    color:var(--dark);
    overflow-x:hidden;
}

body::before{
    content:"";
    position:fixed;
    width:350px;
    height:350px;
    border-radius:50%;
    background: rgba(64,37,31,.09);
    top:-150px;
    right:-100px;
    filter:blur(20px);
    animation:floatBg 8s ease-in-out infinite;
    pointer-events:none;
}

body::after{
    content:"";
    position:fixed;
    width:300px;
    height:300px;
    border-radius:50%;
    background:rgba(249,115,22,.04);
    bottom:-150px;
    left:-100px;
    filter:blur(20px);
    animation:floatBg 10s ease-in-out infinite reverse;
    pointer-events:none;
}

button{
    font-family:inherit;
}

.navbar{
    position:sticky;
    top:0;
    z-index:1000;
    width:100%;
    background:rgba(255,255,255,.9);
    backdrop-filter:blur(18px);
    border-bottom:1px solid rgba(230,235,231,.8);
}

.nav-container{
    max-width:1400px;
    height:76px;
    margin:auto;
    padding:0 30px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:25px;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
    color:var(--dark);
    text-decoration:none;
    font-size:25px;
    font-weight:800;
    letter-spacing:-1px;
}

.logo-icon{
    color: var(--brown);
    font-size: 20px;
    background-color: #40251f;
}

.nav-actions{
    display:flex;
    align-items:center;
    gap:10px;
}

.nav-btn{
    position:relative;
    height:44px;
    padding:0 16px;
    border:1px solid var(--border);
    border-radius:12px;
    background:white;
    color:var(--dark);
    cursor:pointer;
    transition:.3s;
    font-size:13px;
    font-weight:700;
}

.nav-btn:hover{
    transform:translateY(-2px);
    border-color:var(--primary);
    color:var(--primary);
}

.cart-nav{
    background:var(--primary);
    color:white;
    border-color:var(--primary);
    padding:0 19px;
}

.cart-nav:hover{
    background:var(--primary-dark);
    color:white;
}

.cart-count{
    position:absolute;
    top:-7px;
    right:-7px;
    min-width:21px;
    height:21px;
    padding:0 5px;
    display:grid;
    place-items:center;
    border-radius:50px;
    background:var(--accent);
    color:white;
    font-size:10px;
    border:2px solid white;
}

.hero{
    position:relative;
    max-width:1400px;
    min-height:470px;
    margin:35px auto 0;
    padding:70px 65px;
    display:flex;
    align-items:center;
    overflow:hidden;
    border-radius:35px;
    background:
        linear-gradient(110deg,rgba(64,37,31,.09),rgba(64,37,31,.09)),
        url("https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1600&q=80");
    background-size:cover;
    background-position:center;
    box-shadow:0 30px 80px rgba(64,37,31,.18);
}

.hero::before{
    content:"";
    position:absolute;
    width:500px;
    height:500px;
    right:-170px;
    top:-180px;
    border:1px solid rgba(255,255,255,.15);
    border-radius:50%;
    box-shadow:0 0 0 70px rgba(255,255,255,.025),0 0 0 140px rgba(255,255,255,.02);
}

.hero-content{
    position:relative;
    z-index:2;
    max-width:650px;
    color:white;
    animation:heroReveal .9s ease;
}

.hero-tag{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:9px 15px;
    border-radius:50px;
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.16);
    backdrop-filter:blur(10px);
    font-size:11px;
    font-weight:700;
    letter-spacing:1.5px;
    text-transform:uppercase;
}

.hero h1{
    margin-top:20px;
    font-size:clamp(42px,6vw,70px);
    line-height:1;
    letter-spacing:-4px;
    font-weight:800;
}

.hero h1 span{
    color:#9ff0c4;
}

.hero p{
    margin-top:20px;
    max-width:570px;
    color:rgba(255,255,255,.75);
    line-height:1.8;
    font-size:15px;
}

.search-box{
    width:100%;
    max-width:620px;
    height:62px;
    margin-top:30px;
    padding:7px;
    display:flex;
    align-items:center;
    gap:10px;
    background:white;
    border-radius:17px;
    box-shadow:0 15px 40px rgba(0,0,0,.15);
}

.search-icon{
    width:45px;
    display:grid;
    place-items:center;
    color:var(--muted);
    font-size:21px;
}

.search-box input{
    flex:1;
    height:100%;
    border:0;
    outline:0;
    color:var(--dark);
    font-size:13px;
}

.search-btn{
    height:48px;
    padding:0 22px;
    border:0;
    border-radius:12px;
    background:var(--primary);
    color:white;
    font-weight:700;
    cursor:pointer;
    transition:.3s;
}

.search-btn:hover{
    background:var(--primary-dark);
    transform:scale(1.03);
}

.main{
    max-width:1400px;
    margin:70px auto;
    padding:0 30px;
}

.section-heading{
    display:flex;
    align-items:end;
    justify-content:space-between;
    margin-bottom:25px;
}

.section-heading h2{
    font-size:32px;
    letter-spacing:-1.5px;
}

.section-heading p{
    margin-top:7px;
    color:var(--muted);
    font-size:13px;
}

.category-list{
    display:flex;
    gap:10px;
    overflow-x:auto;
    padding:5px 2px 20px;
    scrollbar-width:none;
}

.category-list::-webkit-scrollbar{
    display:none;
}

.category-btn{
    flex-shrink:0;
    padding:12px 19px;
    border:1px solid var(--border);
    border-radius:50px;
    background:white;
    color:var(--text);
    cursor:pointer;
    font-size:12px;
    font-weight:700;
    transition:.3s;
}

.category-btn:hover{
    transform:translateY(-2px);
    border-color:var(--primary);
    color:var(--primary);
}

.category-btn.active{
    background:var(--primary);
    border-color:var(--primary);
    color:white;
    box-shadow:0 8px 20px rgba(13,107,69,.18);
}

.food-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.food-card{
    position:relative;
    background:white;
    border:1px solid var(--border);
    border-radius:25px;
    overflow:hidden;
    box-shadow:var(--shadow);
    opacity:0;
    transform:translateY(35px);
    animation:cardReveal .7s cubic-bezier(.2,.8,.2,1) forwards;
    transition:.45s cubic-bezier(.2,.8,.2,1);
}

.food-card:nth-child(1){animation-delay:.05s}
.food-card:nth-child(2){animation-delay:.1s}
.food-card:nth-child(3){animation-delay:.15s}
.food-card:nth-child(4){animation-delay:.2s}
.food-card:nth-child(5){animation-delay:.25s}
.food-card:nth-child(6){animation-delay:.3s}
.food-card:nth-child(7){animation-delay:.35s}
.food-card:nth-child(8){animation-delay:.4s}
.food-card:nth-child(9){animation-delay:.45s}
.food-card:nth-child(10){animation-delay:.5s}

.food-card:hover{
    transform:translateY(-9px);
    box-shadow:0 30px 70px rgba(20,34,27,.14);
}


.image-box{
    position:relative;
    height:250px;
    overflow:hidden;
    background:#edf0ed;
}

.food-image{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.8s cubic-bezier(.2,.8,.2,1);
}

.food-card:hover .food-image{
    transform:scale(1.1);
}

.badge{
    position:absolute;
    top:15px;
    left:15px;
    z-index:4;
    padding:8px 13px;
    border-radius:50px;
    background:rgba(255,255,255,.95);
    color:var(--primary);
    font-size:9px;
    font-weight:800;
    letter-spacing:1px;
    box-shadow:0 7px 20px rgba(0,0,0,.12);
}

.wishlist{
    position:absolute;
    top:13px;
    right:13px;
    z-index:5;
    width:43px;
    height:43px;
    display:grid;
    place-items:center;
    border:0;
    border-radius:50%;
    background:rgba(255,255,255,.95);
    color:var(--danger);
    font-size:21px;
    cursor:pointer;
    box-shadow:0 8px 20px rgba(0,0,0,.12);
    transition:.3s;
}

.wishlist:hover{
    transform:scale(1.1);
}

.wishlist.active{
    background:var(--danger);
    color:white;
    animation:heartPop .45s ease;
}

.details{
    padding:22px;
}

.category{
    color:var(--primary);
    font-size:10px;
    font-weight:800;
    letter-spacing:1.7px;
    text-transform:uppercase;
}

.food-name{
    margin-top:7px;
    color:var(--dark);
    font-size:23px;
    font-weight:800;
    letter-spacing:-.6px;
}

.rating{
    display:flex;
    align-items:center;
    gap:7px;
    margin-top:9px;
    color:#f59e0b;
    font-size:13px;
}

.rating span{
    color:var(--muted);
    font-size:11px;
}

.description{
    min-height:42px;
    margin-top:12px;
    color:var(--muted);
    font-size:12px;
    line-height:1.7;
}

.price-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-top:16px;
}

.price-box{
    display:flex;
    align-items:center;
    gap:9px;
}

.price{
    font-size:25px;
    font-weight:800;
    color:var(--dark);
}

.old-price{
    color:#abb3ae;
    font-size:11px;
    text-decoration:line-through;
}

.quantity-control{
    display:flex;
    align-items:center;
    height:37px;
    border:1px solid var(--border);
    border-radius:11px;
    overflow:hidden;
}

.quantity-control button{
    width:34px;
    height:37px;
    border:0;
    background:white;
    color:var(--primary);
    font-size:18px;
    cursor:pointer;
    transition:.25s;
}

.quantity-control button:hover{
    background:var(--primary);
    color:white;
}

.quantity-control input{
    width:34px;
    height:37px;
    border:0;
    outline:0;
    text-align:center;
    font-size:12px;
    font-weight:800;
    color:var(--dark);
}

.actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-top:17px;
}

.btn{
    height:43px;
    border:0;
    border-radius:12px;
    font-size:11px;
    font-weight:800;
    cursor:pointer;
    transition:.3s;
}

.cart-btn{
    background:var(--primary);
    color:white;
    box-shadow:0 8px 20px rgba(13,107,69,.18);
}

.cart-btn:hover{
    background:var(--primary-dark);
    transform:translateY(-2px);
}

.buy-btn{
    background:#f1f4f1;
    border:1px solid var(--border);
    color:var(--dark);
}

.buy-btn:hover{
    background:var(--dark);
    color:white;
    transform:translateY(-2px);
}

.no-results{
    display:none;
    grid-column:1/-1;
    padding:70px 20px;
    text-align:center;
}

.no-results div{
    font-size:50px;
}

.no-results h3{
    margin-top:15px;
}

.no-results p{
    margin-top:7px;
    color:var(--muted);
    font-size:13px;
}

.cart-overlay{
    position:fixed;
    inset:0;
    z-index:2000;
    background:rgba(0,0,0,.45);
    backdrop-filter:blur(5px);
    opacity:0;
    visibility:hidden;
    transition:.35s;
}

.cart-overlay.active{
    opacity:1;
    visibility:visible;
}

.cart-drawer{
    position:absolute;
    top:0;
    right:0;
    width:min(430px,100%);
    height:100%;
    display:flex;
    flex-direction:column;
    background:white;
    transform:translateX(100%);
    transition:.45s cubic-bezier(.2,.8,.2,1);
}

.cart-overlay.active .cart-drawer{
    transform:translateX(0);
}

.cart-header{
    height:80px;
    padding:0 25px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid var(--border);
}

.cart-header h2{
    font-size:21px;
}

.close-cart{
    width:38px;
    height:38px;
    border:0;
    border-radius:50%;
    background:#f1f4f1;
    color:var(--dark);
    font-size:20px;
    cursor:pointer;
}

.cart-items{
    flex:1;
    padding:20px;
    overflow-y:auto;
}

.empty-cart{
    height:100%;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    color:var(--muted);
}

.empty-cart-icon{
    font-size:55px;
    margin-bottom:15px;
}

.empty-cart h3{
    color:var(--dark);
    font-size:18px;
}

.empty-cart p{
    margin-top:7px;
    font-size:12px;
}

.cart-item{
    display:flex;
    gap:13px;
    padding:13px 0;
    border-bottom:1px solid var(--border);
    animation:itemIn .35s ease;
}

.cart-item-image{
    width:70px;
    height:70px;
    border-radius:13px;
    object-fit:cover;
}

.cart-item-info{
    flex:1;
}

.cart-item-info h4{
    font-size:13px;
}

.cart-item-price{
    margin-top:5px;
    color:var(--primary);
    font-size:13px;
    font-weight:800;
}

.cart-item-controls{
    display:flex;
    align-items:center;
    gap:7px;
    margin-top:8px;
}

.cart-item-controls button{
    width:25px;
    height:25px;
    border:1px solid var(--border);
    border-radius:7px;
    background:white;
    cursor:pointer;
}

.cart-item-controls span{
    font-size:11px;
    font-weight:700;
}

.remove-item{
    color:var(--danger);
    border:0!important;
}

.cart-footer{
    padding:20px 25px;
    border-top:1px solid var(--border);
    background:#fafcf9;
}

.summary-row{
    display:flex;
    justify-content:space-between;
    margin-bottom:9px;
    color:var(--text);
    font-size:13px;
}

.summary-row.total{
    margin-top:14px;
    padding-top:14px;
    border-top:1px solid var(--border);
    color:var(--dark);
    font-size:19px;
    font-weight:800;
}

.checkout{
    width:100%;
    height:52px;
    margin-top:17px;
    border:0;
    border-radius:14px;
    background:var(--primary);
    color:white;
    font-weight:800;
    cursor:pointer;
    transition:.3s;
}

.checkout:hover{
    background:var(--primary-dark);
    transform:translateY(-2px);
}

.toast{
    position:fixed;
    right:25px;
    bottom:25px;
    z-index:3000;
    min-width:250px;
    padding:15px 18px;
    display:flex;
    align-items:center;
    gap:10px;
    border-radius:13px;
    background:var(--dark);
    color:white;
    box-shadow:0 15px 40px rgba(0,0,0,.2);
    transform:translateY(120px);
    opacity:0;
    transition:.4s;
    font-size:12px;
    font-weight:700;
}

.toast.show{
    transform:translateY(0);
    opacity:1;
}

.footer{
    margin-top:100px;
    padding:50px 30px;
    background:var(--dark);
    color:white;
}

.footer-inner{
    max-width:1400px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    gap:30px;
}

.footer p{
    color:rgba(255,255,255,.55);
    font-size:12px;
    margin-top:10px;
}

@keyframes heroReveal{
    from{
        opacity:0;
        transform:translateY(30px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes cardReveal{
    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes heartPop{
    0%{transform:scale(.6)}
    50%{transform:scale(1.3)}
    100%{transform:scale(1)}
}

@keyframes itemIn{
    from{
        opacity:0;
        transform:translateX(20px);
    }
    to{
        opacity:1;
        transform:translateX(0);
    }
}

@keyframes floatBg{
    0%,100%{transform:translate(0,0)}
    50%{transform:translate(25px,20px)}
}

@media(max-width:1100px){
    .food-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .hero{
        margin-left:20px;
        margin-right:20px;
    }
}

@media(max-width:700px){
    .nav-container{
        padding:0 15px;
    }

    .logo{
        font-size:20px;
    }

    

    .nav-btn{
        padding:0 11px;
    }

    .hero{
        min-height:500px;
        margin:20px 15px 0;
        padding:45px 25px;
        border-radius:25px;
    }

    .hero h1{
        font-size:45px;
        letter-spacing:-2.5px;
    }

    .search-box{
        height:55px;
    }

    .search-btn{
        height:43px;
        padding:0 14px;
    }

    .main{
        margin-top:50px;
        padding:0 15px;
    }

    .food-grid{
        grid-template-columns:1fr;
    }

    .section-heading h2{
        font-size:27px;
    }

    .footer-inner{
        flex-direction:column;
    }
}

@media(max-width:420px){
    .nav-actions{
        gap:5px;
    }

    .nav-btn{
        font-size:11px;
        padding:0 9px;
    }

    .hero h1{
        font-size:39px;
    }

    .hero p{
        font-size:13px;
    }

    .search-btn{
        font-size:10px;
    }

    .image-box{
        height:230px;
    }
}
.logo-iconn{
    color: var(--brown);
    font-size: 20px;
    
}
</style>
</head>

<body>

<nav class="navbar">
    <div class="nav-container">
        <a href="../index.html" class="logo">
            <span class="logo-iconn"> 
                <i class="fa-solid fa-mug-hot"></i>
            </span>
            Our Cafe
        </a>

        <div class="nav-actions">
            <a href="tables.html" class="nav-btn" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;"><i class="fa-solid fa-chair"></i> Tables</a>
            <a href="customer_order_status.html" class="nav-btn" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;"><i class="fa-solid fa-clock-rotate-left"></i> Live Order</a>
            <a href="previous-orders.html" class="nav-btn" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;"><i class="fa-solid fa-receipt"></i> History</a>
            <a href="customer_profile.html" class="nav-btn" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;"><i class="fa-solid fa-user"></i> Profile</a>
            <button class="nav-btn cart-nav" onclick="openCart()">
                🛒 Cart
                <span class="cart-count" id="cartCount">0</span>
            </button>
        </div>
    </div>
</nav>

<section class="hero">
    <div class="hero-content">
        <span class="hero-tag">✦ Freshly prepared for you</span>

        <h1>
            Good food.<br>
            <span>Good mood.</span>
        </h1>

        <p>
            Discover delicious meals, freshly prepared with quality ingredients
            and delivered straight to your door.
        </p>

        <div class="search-box">
            <div class="search-icon">⌕</div>
            <input type="text" id="searchInput" placeholder="Search for biryani, pizza, burger...">
            <button class="search-btn" onclick="searchFood()">Search</button>
        </div>
    </div>
</section>

<main class="main" id="menu">

    <div class="section-heading">
        <div>
            <h2>Explore our menu</h2>
            <p>Choose something delicious for your next meal</p>
        </div>
    </div>

    <div class="category-list">
