<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Artisanal Brews - Order Status</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600&amp;family=EB+Garamond:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-variant": "#eee0d6",
                        "on-surface": "#211a14",
                        "inverse-surface": "#372f28",
                        "on-primary-container": "#bd9f83",
                        "outline": "#80756c",
                        "on-primary-fixed": "#291806",
                        "tertiary-container": "#253f32",
                        "on-primary": "#ffffff",
                        "secondary-fixed-dim": "#c9c6bf",
                        "surface-container-highest": "#eee0d6",
                        "primary-fixed-dim": "#e1c1a4",
                        "on-error": "#ffffff",
                        "outline-variant": "#d2c4ba",
                        "on-background": "#211a14",
                        "tertiary-fixed": "#ccead6",
                        "surface-container-lowest": "#ffffff",
                        "surface-dim": "#e5d8ce",
                        "background": "#fff8f5",
                        "on-primary-fixed-variant": "#59422c",
                        "on-secondary": "#ffffff",
                        "surface-tint": "#725a42",
                        "primary-fixed": "#fedcbe",
                        "surface-container": "#faebe1",
                        "on-error-container": "#93000a",
                        "secondary-container": "#e6e2da",
                        "on-tertiary": "#ffffff",
                        "surface": "#fff8f5",
                        "surface-container-low": "#fff1e7",
                        "surface-container-high": "#f4e6db",
                        "surface-bright": "#fff8f5",
                        "tertiary": "#0f291d",
                        "secondary-fixed": "#e6e2da",
                        "error": "#ba1a1a",
                        "secondary": "#605e58",
                        "inverse-primary": "#e1c1a4",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed": "#062014",
                        "primary-container": "#4b3621",
                        "primary": "#33210d",
                        "on-surface-variant": "#4e453d",
                        "on-secondary-fixed-variant": "#484741",
                        "on-tertiary-container": "#8eaa99",
                        "on-secondary-container": "#66645e",
                        "tertiary-fixed-dim": "#b0cdbb",
                        "on-tertiary-fixed-variant": "#324c3e",
                        "on-secondary-fixed": "#1c1c17",
                        "inverse-on-surface": "#fceee4"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "xs": "4px",
                        "lg": "48px",
                        "margin-mobile": "16px",
                        "sm": "12px",
                        "margin-desktop": "64px",
                        "xl": "80px",
                        "md": "24px",
                        "gutter": "20px",
                        "base": "8px"
                    },
                    "fontFamily": {
                        "body-lg": ["Be Vietnam Pro"],
                        "headline-md-mobile": ["EB Garamond"],
                        "label-sm": ["Be Vietnam Pro"],
                        "body-md": ["Be Vietnam Pro"],
                        "title-lg": ["Be Vietnam Pro"],
                        "display-lg-mobile": ["EB Garamond"],
                        "headline-md": ["EB Garamond"],
                        "display-lg": ["EB Garamond"]
                    },
                    "fontSize": {
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "headline-md-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "500" }],
                        "label-sm": ["13px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "title-lg": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "headline-md": ["32px", { "lineHeight": "40px", "fontWeight": "500" }],
                        "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>
<style>
        .progress-pulse {
            animation: pulse-border 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse-border {
            0%, 100% {
                border-color: rgba(75, 54, 33, 0.2);
            }
            50% {
                border-color: rgba(75, 54, 33, 1);
            }
        }
    </style>
</head>
<body class="bg-background text-on-background font-body-md min-h-screen flex flex-col antialiased">
<!-- TopAppBar -->
<header class="bg-surface dark:bg-surface-dim w-full top-0 sticky border-b border-outline-variant dark:border-outline shadow-sm z-40">
<div class="flex justify-between items-center px-margin-mobile md:px-margin-desktop py-base w-full">
<a href="/index" class="font-headline-md text-headline-md text-primary dark:text-primary-fixed-dim flex items-center gap-2 no-underline">
    <span class="material-symbols-outlined">coffee</span> Our Cafe
</a>
<div class="flex items-center gap-4">
<a href="/tables" class="text-primary font-medium hover:underline text-sm hidden sm:inline">Select Table</a>
<a href="/menu" class="text-primary font-medium hover:underline text-sm hidden sm:inline">Menu</a>
<a href="/previous-orders" class="text-primary font-medium hover:underline text-sm hidden sm:inline">Order History</a>
<a href="/customer_profile" title="My Profile" class="text-primary cursor-pointer hover:bg-surface-container-high transition-colors p-2 rounded-full">
    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">account_circle</span>
</a>
<a href="/menu" title="Cart / Menu" class="text-primary cursor-pointer hover:bg-surface-container-high transition-colors p-2 rounded-full">
    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">shopping_bag</span>
</a>
</div>
</div>
</header>
<!-- Main Content Canvas -->
<main class="flex-grow flex flex-col items-center p-margin-mobile md:p-margin-desktop max-w-5xl mx-auto w-full gap-lg">
<div class="text-center space-y-4">
    <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary">
        Your live orders
    </h1>
    <p class="font-title-lg text-title-lg text-on-surface-variant">
        Track the items you've ordered from our cafe.
    </p>
</div>

<% if (order.length === 0) { %>
    <section class="w-full max-w-2xl bg-surface rounded-xl p-lg border border-outline-variant/50 shadow-sm text-center">
        <span class="material-symbols-outlined text-primary text-5xl">receipt_long</span>
        <h2 class="font-title-lg text-title-lg text-primary mt-3">No active orders</h2>
        <p class="text-on-surface-variant mt-2">When you place an order, its status will appear here.</p>
        <a href="/menu" class="inline-block mt-6 rounded-lg bg-primary px-5 py-3 text-on-primary font-semibold hover:opacity-90">Browse the menu</a>
    </section>
<% } else { %>
    <div class="w-full max-w-2xl flex flex-col gap-md">
        <% order.forEach(function(item) { %>
            <article class="bg-surface rounded-xl p-md md:p-lg border border-outline-variant/50 shadow-sm">
                <div class="flex flex-wrap justify-between items-start gap-3 border-b border-outline-variant/30 pb-md">
                    <div>
                        <p class="font-label-sm text-label-sm uppercase text-on-surface-variant">Order received</p>
                        <h2 class="font-title-lg text-title-lg text-primary mt-1">Table <%= item.tableNumber || "—" %></h2>
                    </div>
                    <% if (item.status === "completed") { %>
                        <span class="inline-flex items-center gap-2 rounded-full bg-tertiary-container/30 px-3 py-2 text-sm font-semibold text-tertiary">
                            <span class="w-2 h-2 rounded-full bg-tertiary"></span>
                            Order completed
                        </span>
                    <% } else if (item.status === "accepted") { %>
                        <span class="inline-flex items-center gap-2 rounded-full bg-tertiary-container/30 px-3 py-2 text-sm font-semibold text-tertiary">
                            <span class="w-2 h-2 rounded-full bg-tertiary"></span>
                            Accepted · <%= item.prepTime %> mins
                        </span>
                    <% } else { %>
                        <span class="inline-flex items-center gap-2 rounded-full bg-surface-container px-3 py-2 text-sm font-semibold text-primary">
                            <span class="w-2 h-2 rounded-full bg-primary"></span>
                            Received by cafe
                        </span>
                    <% } %>
                </div>

                <div class="flex justify-between items-center gap-4 py-md">
                    <div class="flex items-center gap-md min-w-0">
                        <% if (item.img) { %>
                            <img class="w-16 h-16 rounded-md object-cover bg-surface-container-high" src="<%= item.img %>" alt="<%= item.itemName %>">
                        <% } else { %>
                            <div class="w-16 h-16 rounded-md bg-surface-container-high flex items-center justify-center">
                                <span class="material-symbols-outlined text-primary text-3xl">restaurant</span>
                            </div>
                        <% } %>
                        <div class="min-w-0">
                            <h3 class="font-body-lg text-body-lg text-on-surface break-words"><%= item.itemName %></h3>
                            <p class="font-body-md text-body-md text-on-surface-variant">Placed <%= item.timestamp ? new Date(item.timestamp).toLocaleString() : "recently" %></p>
                        </div>
                    </div>
                    <p class="font-body-lg text-body-lg text-primary font-semibold whitespace-nowrap">₹<%= Number(item.price || 0).toFixed(2) %></p>
                </div>

                <p class="text-sm text-on-surface-variant border-t border-outline-variant/30 pt-md">
                    <% if (item.status === "completed") { %>
                        Your order has been completed. Thank you for visiting!
                    <% } else if (item.status === "accepted") { %>
                        Your order has been accepted. Estimated preparation time: <strong><%= item.prepTime %> mins</strong>.
                    <% } else { %>
                        Your order has been received. The cafe will confirm an estimated preparation time shortly.
                    <% } %>
                </p>
            </article>
        <% }); %>
    </div>
<% } %>
</main>
</body></html>