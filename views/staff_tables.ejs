
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Portal | Table Management</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=EB+Garamond:wght@500;600;700&display=swap" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#33210d",
                        background: "#fff8f5",
                        surface: "#ffffff",
                        muted: "#80756c",
                        line: "#eadbd0"
                    },
                    fontFamily: {
                        sans: ["Be Vietnam Pro", "sans-serif"],
                        serif: ["EB Garamond", "serif"]
                    }
                }
            }
        };
    </script>

    <style>
        body {
            font-family: "Be Vietnam Pro", sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 400;
        }

        .status-tab {
            transition: all 0.2s ease;
        }

        .table-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            animation: fadeIn 0.3s ease both;
        }

        .table-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 35px rgba(51, 33, 13, 0.09);
        }

        .sidebar-link.active {
            background: #33210d;
            color: white;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body class="bg-background text-primary min-h-screen">

    <!-- Mobile Header -->
    <header class="lg:hidden bg-white border-b border-line px-5 py-4 flex items-center justify-between sticky top-0 z-40">
        <div>
            <h2 class="font-serif text-2xl font-bold">Staff Portal</h2>
            <p class="text-xs text-muted">Table Operations</p>
        </div>

        <button onclick="toggleSidebar()"
            class="p-2 rounded-xl hover:bg-orange-50"
            aria-label="Toggle navigation">
            <span class="material-symbols-outlined">menu</span>
        </button>
    </header>

    <!-- Mobile Overlay -->
    <div id="sidebarOverlay"
        onclick="toggleSidebar()"
        class="fixed inset-0 bg-black/40 z-40 hidden lg:hidden">
    </div>

    <!-- Sidebar -->
    <aside id="sidebar"
        class="fixed top-0 left-0 z-50 h-screen w-72 bg-white border-r border-line
               flex flex-col p-6 transition-transform duration-300
               -translate-x-full lg:translate-x-0">

        <div class="mb-10 px-2">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-12 h-12 rounded-2xl bg-primary text-white flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">restaurant</span>
                </div>
                <div>
                    <h2 class="font-serif text-2xl font-bold">Staff Portal</h2>
                    <p class="text-xs text-muted">Restaurant Operations</p>
                </div>
            </div>
        </div>

        <p class="text-[10px] uppercase tracking-[0.2em] text-muted font-bold px-3 mb-3">
            Workspace
        </p>

        <nav class="flex flex-col gap-2 flex-1">

            <a href="/reception_order_management"
                class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm text-gray-600 hover:bg-orange-50">
                <span class="material-symbols-outlined">receipt_long</span>
                Active Orders
            </a>

            <a href="/staff_tables"
                class="sidebar-link active flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold">
                <span class="material-symbols-outlined">table_restaurant</span>
                Table Management
            </a>

            <a href="/staffMenu"
                class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm text-gray-600 hover:bg-orange-50">
                <span class="material-symbols-outlined">restaurant_menu</span>
                Menu Inventory
            </a>

            <a href="/staff_analytics"
                class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm text-gray-600 hover:bg-orange-50">
                <span class="material-symbols-outlined">monitoring</span>
                Sales & Analytics
            </a>
        </nav>

        <div class="border-t border-line pt-5 mt-6">
            <div class="flex items-center gap-3 mb-5">
                <div class="w-11 h-11 rounded-full bg-orange-100 flex items-center justify-center font-bold">
                    SL
                </div>
                <div>
                    <p class="text-sm font-bold">Staff Lead</p>
                    <p class="text-xs text-muted">Shift Manager</p>
                </div>
            </div>

            <a href="/login"
                class="flex items-center gap-3 text-sm text-red-600 hover:bg-red-50 p-3 rounded-xl">
                <span class="material-symbols-outlined">logout</span>
                Logout
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="lg:ml-72 min-h-screen p-5 sm:p-8 lg:p-10">

        <div class="max-w-7xl mx-auto">

            <!-- Page Heading -->
            <section class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-5 mb-9">

                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-800 mb-2">
                        Restaurant Operations
                    </p>

                    <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight">
                        Table Management
                    </h1>

                    <p class="text-sm text-muted mt-3">
                        Manage seating, track availability, and keep your floor running smoothly.
                    </p>
                </div>

                <div class="flex gap-3">
                    <button onclick="window.location.reload()"
                        class="inline-flex items-center justify-center gap-2 border border-line bg-white
                               px-4 py-3 rounded-xl text-sm font-semibold hover:bg-orange-50">
                        <span class="material-symbols-outlined text-lg">refresh</span>
                        Refresh
                    </button>
                </div>
            </section>

            <!-- Statistics -->
            <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-9">

                <div class="bg-white border border-line rounded-2xl p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-5">
                        <span class="text-sm text-muted font-medium">Total Tables</span>
                        <div class="w-11 h-11 rounded-xl bg-orange-100 flex items-center justify-center">
                            <span class="material-symbols-outlined">table_restaurant</span>
                        </div>
                    </div>
                    <h2 class="text-3xl font-extrabold">
                        <%= tablesData.length %>
                    </h2>
                    <p class="text-xs text-muted mt-2">
                        <%= totalSeats %> total seats
                    </p>
                </div>

                <div class="bg-white border border-emerald-200 rounded-2xl p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-5">
                        <span class="text-sm text-emerald-800 font-medium">Available</span>
                        <div class="w-11 h-11 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-700">
                            <span class="material-symbols-outlined">check_circle</span>
                        </div>
                    </div>
                    <h2 class="text-3xl font-extrabold text-emerald-700">
                        <%= availableCount %>
                    </h2>
                    <p class="text-xs text-muted mt-2">Ready for new guests</p>
                </div>

                <div class="bg-white border border-amber-200 rounded-2xl p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-5">
                        <span class="text-sm text-amber-800 font-medium">Occupied</span>
                        <div class="w-11 h-11 rounded-xl bg-amber-100 flex items-center justify-center text-amber-700">
                            <span class="material-symbols-outlined">groups</span>
                        </div>
                    </div>
                    <h2 class="text-3xl font-extrabold text-amber-700">
                        <%= occupiedCount %>
                    </h2>
                    <p class="text-xs text-muted mt-2">Currently serving guests</p>
                </div>

                <div class="bg-white border border-rose-200 rounded-2xl p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-5">
                        <span class="text-sm text-rose-800 font-medium">Needs Cleaning</span>
                        <div class="w-11 h-11 rounded-xl bg-rose-100 flex items-center justify-center text-rose-700">
                            <span class="material-symbols-outlined">cleaning_services</span>
                        </div>
                    </div>
                    <h2 class="text-3xl font-extrabold text-rose-700">
                        <%= cleaningCount %>
                    </h2>
                    <p class="text-xs text-muted mt-2">Awaiting table preparation</p>
                </div>

            </section>

            <!-- Table Directory -->
            <section class="bg-white border border-line rounded-2xl p-5 sm:p-7 shadow-sm">

                <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-5 mb-7">

                    <div>
                        <h2 class="font-serif text-3xl font-bold">Floor Overview</h2>
                        <p class="text-sm text-muted mt-1">
                            Select a status to find tables quickly.
                        </p>
                    </div>

                    <!-- Search -->
                    <div class="relative w-full xl:max-w-xs">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-muted">
                            search
                        </span>

                        <input id="tableSearch"
                            type="search"
                            placeholder="Search table number..."
                            class="w-full pl-10 pr-4 py-3 border border-line rounded-xl text-sm
                                   focus:outline-none focus:ring-2 focus:ring-amber-800/20 focus:border-amber-800">
                    </div>
                </div>

                <!-- Filters -->
                <div class="flex flex-wrap gap-2 mb-7" id="statusFilters">

                    <button type="button" data-filter="all"
                        class="status-tab px-4 py-2.5 rounded-xl text-sm font-semibold bg-primary text-white">
                        All Tables (<%= tablesData.length %>)
                    </button>

                    <button type="button" data-filter="available"
                        class="status-tab px-4 py-2.5 rounded-xl text-sm font-semibold bg-gray-100 text-gray-600 hover:bg-emerald-50">
                        Available (<%= availableCount %>)
                    </button>

                    <button type="button" data-filter="occupied"
                        class="status-tab px-4 py-2.5 rounded-xl text-sm font-semibold bg-gray-100 text-gray-600 hover:bg-amber-50">
                        Occupied (<%= occupiedCount %>)
                    </button>

                    <button type="button" data-filter="cleaning"
                        class="status-tab px-4 py-2.5 rounded-xl text-sm font-semibold bg-gray-100 text-gray-600 hover:bg-rose-50">
                        Cleaning (<%= cleaningCount %>)
                    </button>

                </div>

                <!-- Feedback -->
                <div id="notice"
                    role="status"
                    aria-live="polite"
                    class="hidden mb-5 rounded-xl px-4 py-3 text-sm">
                </div>

                <!-- Table Cards -->
                <div id="tablesContainer"
                    class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-5">

                    <% tablesData.forEach((table, index) => {
                        const status = ["available", "occupied", "cleaning"].includes(table.status)
                            ? table.status
                            : "unknown";

                        const tableNumber = table.number ?? table.tableNumber ?? index + 1;
                        const seats = Number(table.seats) || 0;

                        const statusStyles = {
                            available: {
                                badge: "bg-emerald-50 text-emerald-700 border-emerald-200",
                                icon: "check_circle",
                                accent: "bg-emerald-500",
                                label: "Available"
                            },
                            occupied: {
                                badge: "bg-amber-50 text-amber-700 border-amber-200",
                                icon: "groups",
                                accent: "bg-amber-500",
                                label: "Occupied"
                            },
                            cleaning: {
                                badge: "bg-rose-50 text-rose-700 border-rose-200",
                                icon: "cleaning_services",
                                accent: "bg-rose-500",
                                label: "Cleaning"
                            },
                            unknown: {
                                badge: "bg-gray-100 text-gray-600 border-gray-200",
                                icon: "help",
                                accent: "bg-gray-400",
                                label: "Unknown"
                            }
                        };

                        const style = statusStyles[status];
                    %>

                    <article
                        class="table-card table-item relative overflow-hidden border border-line rounded-2xl p-5 bg-white"
                        data-status="<%= status %>"
                        data-number="<%= tableNumber %>"
                        data-customer="<%= table.customer || '' %>">

                        <div class="absolute top-0 left-0 right-0 h-1 <%= style.accent %>"></div>

                        <div class="flex items-start justify-between gap-3 mb-5 mt-1">

                            <div>
                                <p class="text-xs text-muted font-medium mb-1">Restaurant seating</p>
                                <h3 class="font-serif text-3xl font-bold">
                                    Table <%= tableNumber %>
                                </h3>
                            </div>

                            <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1.5 text-[10px] font-bold <%= style.badge %>">
                                <span class="material-symbols-outlined text-sm">
                                    <%= style.icon %>
                                </span>
                                <%= style.label %>
                            </span>
                        </div>

                        <div class="flex items-center gap-3 bg-orange-50/70 rounded-xl p-3 mb-4">
                            <div class="w-10 h-10 rounded-lg bg-white flex items-center justify-center">
                                <span class="material-symbols-outlined">chair</span>
                            </div>
                            <div>
                                <p class="text-sm font-bold">
                                    <%= seats %> Seats
                                </p>
                                <p class="text-xs text-muted">Table capacity</p>
                            </div>
                        </div>

                        <div class="min-h-[48px] mb-4">
                            <p class="text-[10px] uppercase tracking-widest text-muted font-bold mb-1">
                                Guest / Status details
                            </p>
                            <p class="text-sm font-medium break-words">
                                <% if (status === "available") { %>
                                    Ready for guests
                                <% } else if (table.customer) { %>
                                    <%= table.customer %>
                                <% } else if (status === "cleaning") { %>
                                    Awaiting cleaning
                                <% } else { %>
                                    No guest details
                                <% } %>
                            </p>
                        </div>

                        <div class="border-t border-line pt-4 flex flex-col gap-2">

                            <% if (status === "available") { %>
                                <button type="button"
                                    onclick="updateStatus('<%= table._id %>', 'occupied', this)"
                                    class="w-full flex items-center justify-center gap-2 py-3 px-3 rounded-xl bg-primary text-white text-sm font-semibold hover:bg-amber-950 transition-colors">
                                    <span class="material-symbols-outlined text-lg">person_add</span>
                                    Seat Guests
                                </button>

                            <% } else if (status === "occupied") { %>
                                <button type="button"
                                    onclick="updateStatus('<%= table._id %>', 'cleaning', this)"
                                    class="w-full flex items-center justify-center gap-2 py-3 px-3 rounded-xl bg-amber-600 text-white text-sm font-semibold hover:bg-amber-700 transition-colors">
                                    <span class="material-symbols-outlined text-lg">cleaning_services</span>
                                    Clear Table
                                </button>

                            <% } else if (status === "cleaning") { %>
                                <button type="button"
                                    onclick="updateStatus('<%= table._id %>', 'available', this)"
                                    class="w-full flex items-center justify-center gap-2 py-3 px-3 rounded-xl bg-emerald-700 text-white text-sm font-semibold hover:bg-emerald-800 transition-colors">
                                    <span class="material-symbols-outlined text-lg">check_circle</span>
                                    Mark as Clean
                                </button>

                            <% } else { %>
                                <button type="button" disabled
                                    class="w-full py-3 px-3 rounded-xl bg-gray-100 text-gray-500 text-sm font-semibold cursor-not-allowed">
                                    Check table status
                                </button>
                            <% } %>

                        </div>
                    </article>

                    <% }); %>

                </div>

                <!-- Empty Search State -->
                <div id="emptyState" class="hidden text-center py-16">
                    <div class="w-16 h-16 bg-orange-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-3xl text-muted">search_off</span>
                    </div>
                    <h3 class="font-serif text-2xl font-bold">No tables found</h3>
                    <p class="text-sm text-muted mt-2">
                        Try another search or select a different status.
                    </p>
                    <button onclick="resetFilters()"
                        class="mt-5 px-5 py-3 bg-primary text-white rounded-xl text-sm font-semibold">
                        Show All Tables
                    </button>
                </div>

                <!-- Footer -->
                <div class="mt-8 pt-5 border-t border-line flex flex-col sm:flex-row sm:justify-between gap-2">
                    <p class="text-xs text-muted">
                        Showing <span id="visibleCount"><%= tablesData.length %></span>
                        of <%= tablesData.length %> tables
                    </p>
                    <p class="text-xs text-muted flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        Data loaded from the restaurant database
                    </p>
                </div>

            </section>

        </div>
    </main>

    <script>
        let activeFilter = "all";

        const searchInput = document.getElementById("tableSearch");
        const tableCards = Array.from(document.querySelectorAll(".table-item"));
        const filterButtons = document.querySelectorAll(".status-tab");
        const emptyState = document.getElementById("emptyState");
        const visibleCount = document.getElementById("visibleCount");
        const notice = document.getElementById("notice");

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("-translate-x-full");
            document.getElementById("sidebarOverlay").classList.toggle("hidden");
        }

        function showNotice(message, type = "success") {
            notice.textContent = message;
            notice.className = "mb-5 rounded-xl px-4 py-3 text-sm";

            if (type === "success") {
                notice.classList.add("bg-emerald-50", "text-emerald-800", "border", "border-emerald-200");
            } else {
                notice.classList.add("bg-rose-50", "text-rose-800", "border", "border-rose-200");
            }

            notice.classList.remove("hidden");
        }

        function applyFilters() {
            const query = searchInput.value.trim().toLowerCase();
            let count = 0;

            tableCards.forEach(card => {
                const status = card.dataset.status;
                const number = card.dataset.number.toLowerCase();
                const customer = card.dataset.customer.toLowerCase();

                const matchesStatus =
                    activeFilter === "all" || status === activeFilter;

                const matchesSearch =
                    number.includes(query) || customer.includes(query);

                const visible = matchesStatus && matchesSearch;

                card.classList.toggle("hidden", !visible);

                if (visible) count++;
            });

            visibleCount.textContent = count;
            emptyState.classList.toggle("hidden", count !== 0);
        }

        filterButtons.forEach(button => {
            button.addEventListener("click", () => {
                activeFilter = button.dataset.filter;

                filterButtons.forEach(tab => {
                    tab.classList.remove("bg-primary", "text-white");
                    tab.classList.add("bg-gray-100", "text-gray-600");
                });

                button.classList.remove("bg-gray-100", "text-gray-600");
                button.classList.add("bg-primary", "text-white");

                applyFilters();
            });
        });

        searchInput.addEventListener("input", applyFilters);

        function resetFilters() {
            activeFilter = "all";
            searchInput.value = "";

            const allButton = document.querySelector('[data-filter="all"]');
            allButton.click();

            applyFilters();
        }

        async function updateStatus(id, status, button) {
            const originalContent = button.innerHTML;

            button.disabled = true;
            button.innerHTML = `
                <span class="material-symbols-outlined animate-spin text-lg">progress_activity</span>
                Updating...
            `;

            try {
                const response = await fetch(
                    `/staff_tables/${encodeURIComponent(id)}/status`,
                    {
                        method: "PATCH",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ status })
                    }
                );

                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(result.message || "Unable to update table.");
                }

                showNotice(result.message || "Table status updated successfully.");

                // Reload to retrieve the latest saved status and counts.
                window.setTimeout(() => {
                    window.location.reload();
                }, 500);

            } catch (error) {
                showNotice(error.message || "Something went wrong.", "error");
                button.disabled = false;
                button.innerHTML = originalContent;
            }
        }

        applyFilters();
    </script>

</body>
</html>
