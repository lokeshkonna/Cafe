<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - Our Cafe</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="style.css">
    <style>
          * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --brown: #6a4034;
    --dark-brown: #40251f;
    --cream: #f8f5f0;
    --white: #ffffff;
}

body {
    font-family: "DM Sans", sans-serif;
    color: var(--white);
}

.hero {
    min-height: 100vh;
    position: relative;
    background:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.78) 0%,
            rgba(0, 0, 0, 0.65) 42%,
            rgba(0, 0, 0, 0.28) 100%
        ),
        url("img-1.png") center center / cover no-repeat;
}

.top-bar {
    height: 50px;
    padding: 0 13%;
    background: #5a352b;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 9px;
}

.top-left {
    display: flex;
    align-items: center;
    gap: 6px;
}

.top-left i {
    font-size: 16px;
}
.top-left span{
    font-size: 12px;;
}
.social-icons {
    display: flex;
    align-items: center;
    gap: 15px;

}
.social-icons i{
    font-size: 16px;
}

.social-icons a,
.top-right a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

.social-icons a:hover,
.top-right a:hover {
    color: #d5a48d;
}

.top-right {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 17px;
}
.top-right i{
    font-size: 14px;
}
.login-top {
    height: 100%;
    padding: 0 24px;
    display: flex;
    align-items: center;
    background: #3d241e;
    font-size: 14px;
}

.navbar {
    height: 67px;
    padding: 0 13%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 10;
}

.logo {
    color: white;
    text-decoration: none;
    font-family: "Playfair Display", serif;
    font-size: 23px;
    font-weight: 600;
    display: flex;
    align-items: center;
    white-space: nowrap;
}

.logo > span:last-child {
    color: #c18c70;
}

.logo-icon {
    color: var(--brown);
    font-size: 20px;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-family: "Playfair Display", serif;
    font-size: 16px;
    transition: 0.3s;
}

.nav-links a:hover,
.nav-links a.active {
    color: #c99378;
}

.nav-contact {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "Playfair Display", serif;
    font-size: 12px;
    white-space: nowrap;
}

.nav-contact i {
    font-size: 16px;
}
.nav-contact span{
    font-size: 16px;
    font-family: sans-serif;
}
.menu-btn {
    display: none;
    border: none;
    background: transparent;
    color: white;
    font-size: 22px;
    cursor: pointer;
}

        .contact-section {
            background: #f8f5f0;
            color: #3d241e;
            padding: 80px 13%;
            min-height: 80vh;
        }
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            margin-top: 40px;
        }
        .contact-info-card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid #ded8d3;
            display: flex;
            flex-direction: column;
            gap: 25px;
        }
        .info-item {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .info-item i {
            width: 50px;
            height: 50px;
            background: #f0e5de;
            color: #684035;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }
        .contact-form-card {
            background: white;
            padding: 35px;
            border-radius: 12px;
            border: 1px solid #ded8d3;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 8px;
            color: #3d241e;
        }
        .form-group input, .form-group textarea {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #ded8d3;
            border-radius: 6px;
            font-family: inherit;
            font-size: 14px;
        }
        .submit-btn {
            background: #3d241e;
            color: white;
            border: none;
            padding: 14px 28px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            transition: 0.3s;
        }
        .submit-btn:hover {
            background: #684035;
        }
        
/* Toast notification */
.toast {
    position: fixed;
    top: 25px;
    right: 25px;
    z-index: 9999;
    width: min(380px, calc(100vw - 30px));
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 20px 40px 24px 18px;
    background: #ffffff;
    color: #252525;
    border-radius: 14px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    border-left: 5px solid #22c55e;

    opacity: 0;
    visibility: hidden;
    transform: translateX(120%);
    transition: opacity 0.4s ease,
                transform 0.4s cubic-bezier(.2, .8, .2, 1),
                visibility 0.4s;
    overflow: hidden;
}

.toast.show {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
}

.toast.error {
    border-left-color: #ef4444;
}

.toast-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #dcfce7;
    color: #16a34a;
    font-size: 21px;
    font-weight: bold;
}

.toast.error .toast-icon {
    background: #fee2e2;
    color: #dc2626;
}

.toast-content h4 {
    margin: 2px 0 6px;
    font-size: 16px;
    font-weight: 700;
}

.toast-content p {
    margin: 0;
    color: #666;
    font-size: 14px;
    line-height: 1.5;
}

.toast-close {
    position: absolute;
    top: 8px;
    right: 12px;
    border: none;
    background: transparent;
    color: #888;
    font-size: 25px;
    cursor: pointer;
}

.toast-close:hover {
    color: #222;
}

.toast-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 3px;
    background: #22c55e;
    transform-origin: left;
}

.toast.error .toast-progress {
    background: #ef4444;
}

.toast.show .toast-progress {
    animation: toastTimer 4s linear forwards;
}

@keyframes toastTimer {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
}

@media (max-width: 480px) {
    .toast {
        top: 15px;
        right: 15px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .toast {
        transition: none;
    }

    .toast.show .toast-progress {
        animation: none;
    }
}

    </style>
</head>
<body>
    <div class="top-bar">
        <div class="top-left">
            <span><i class="fa-solid fa-clock"></i> Mon - Fri: 9:00 - 19:00 / Closed on Weekends</span>
        </div>
        <div class="social-icons">
            <a href="https://facebook.com" target="_blank"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="https://instagram.com" target="_blank"><i class="fa-brands fa-instagram"></i></a>
            <a href="https://twitter.com" target="_blank"><i class="fa-brands fa-x-twitter"></i></a>
            <a href="https://youtube.com" target="_blank"><i class="fa-brands fa-youtube"></i></a>
        </div>
        <div class="top-right">
            <a href="/menu" title="Cart / Menu"><i class="fa-solid fa-cart-shopping"></i></a>
            <a href="/profile" title="Profile"><i class="fa-regular fa-user"></i></a>
            <a href="/login" class="login-top">LOGIN OR SIGN UP</a>
        </div>
    </div>

    <nav class="navbar" style="background:#3d241e; border-bottom: 1px solid rgba(255,255,255,0.1);">
        <a href="/index" class="logo" style="color:white;">
            <span class="logo-icon"><i class="fa-solid fa-mug-hot"></i></span> Our Cafe
        </a>
        <ul class="nav-links">
            <li><a href="/index">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/menu">Menu</a></li>
            <li><a href="/tables">Book Table</a></li>
            <li><a href="/order-status">Order Status</a></li>
            <li><a href="/contact" class="active">Contact</a></li>
        </ul>
        <div class="nav-contact" style="color:white;">
            <i class="fa-solid fa-phone-volume"></i><a href="tel:+917052101786" style="text-decoration: none; color: white;"> <span type="tel" for="+91 705 210-1786">+91 705 210-1786</span></a>
        </div>
    </nav>

    <section class="contact-section">
        <p class="subtitle" style="color:#684035; font-family:'Playfair Display', serif; font-weight:600;">GET IN TOUCH</p>
        <h1 style="font-family:'Playfair Display', serif; font-size:42px;">We'd Love to Hear From You</h1>
        
        <div class="contact-grid">
            <div class="contact-info-card">
                <div class="info-item">
                    <i class="fa-solid fa-location-dot"></i>
                    <div>
                        <h4 style="font-weight:600; font-size:16px;">Our Location</h4>
                        <p style="color:#777; font-size:14px;">123 Coffee Avenue, Artisanal District</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fa-solid fa-phone"></i>
                    <div>
                        <h4 style="font-weight:600; font-size:16px;">Phone Number</h4>
                        <p style="color:#777; font-size:14px;">+91 705 210-1786</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fa-solid fa-envelope"></i>
                    <div>
                        <h4 style="font-weight:600; font-size:16px;">Email Address</h4>
                        <p style="color:#777; font-size:14px;">contact@ourcafe.com</p>
                    </div>
                </div>
            </div>

            <div class="contact-form-card">
                <form id="contactForm" action="/contact" method="POST">
                    <div class="form-group">
                        <label for="name">Your Name</label>
                        <input type="text" id="name" name="name" required placeholder="John Doe">
                    </div>
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" required placeholder="john@example.com">
                    </div>
                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" rows="4" required placeholder="How can we help you?"></textarea>
                    </div>
                    <button type="submit" class="submit-btn" onclick="fun()">Send Message</button>
                </form>
            </div>
        </div>
    </section>
    
    <script>
        
const form = document.getElementById("contactForm");

let toastTimeout;

function showToast(type, title, message) {
    const toast = document.getElementById("toast");
    const toastIcon = document.getElementById("toastIcon");
    const toastTitle = document.getElementById("toastTitle");
    const toastMessage = document.getElementById("toastMessage");
    const progress = document.getElementById("toastProgress");

    clearTimeout(toastTimeout);

    toast.classList.remove("show", "error");
    void toast.offsetWidth; // Restart the animation

    if (type === "success") {
        toastIcon.textContent = "✓";
        toastTitle.textContent = title;
        toastMessage.textContent = message;
    } else {
        toast.classList.add("error");
        toastIcon.textContent = "!";
        toastTitle.textContent = title;
        toastMessage.textContent = message;
    }

    progress.style.animation = "none";
    void progress.offsetWidth;
    progress.style.animation = "";

    toast.classList.add("show");

    toastTimeout = setTimeout(hideToast, 4000);
}

function hideToast() {
    document.getElementById("toast").classList.remove("show");
    clearTimeout(toastTimeout);
}

form.addEventListener("submit", function(event) {
    event.preventDefault();

    const name = document.getElementById("name").value.trim();
    const email = document.getElementById("email").value.trim();
    const message = document.getElementById("message").value.trim();

    if (!name || !email || !message) {
        showToast(
            "error",
            "Missing Information",
            "Please fill in all fields before submitting."
        );
        return;
    }

    if (!document.getElementById("email").checkValidity()) {
        showToast(
            "error",
            "Invalid Email",
            "Please enter a valid email address."
        );
        return;
    }

    showToast(
        "success",
        "Message Sent!",
        "Thank you for contacting Our Cafe. We appreciate it!"
    );

    // Keep the form on the page while showing the notification.
    // Add your backend/API submission here to actually send the message.
});

    </script>
    
<div id="toast" class="toast">
    <div class="toast-icon" id="toastIcon"></div>

    <div class="toast-content">
        <h4 id="toastTitle">Success!</h4>
        <p id="toastMessage">Your message has been sent successfully.</p>
    </div>

    <button type="button" class="toast-close"
        onclick="hideToast()" aria-label="Close notification">
        &times;
    </button>

    <div class="toast-progress" id="toastProgress"></div>
</div>

</body>
</html>
