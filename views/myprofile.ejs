            <a href="order-status.html">

                <i class="fa-solid fa-clock-rotate-left"></i>

                Live Order

            </a>


            <a href="history.html">

                <i class="fa-solid fa-receipt"></i>

                History

            </a>

        </nav>


        <!-- RIGHT SIDE -->

        <div class="nav-right">


            <div class="username">

                <i class="fa-solid fa-circle-user"></i>

                <span>lokesh</span>

            </div>


            <a href="logout.php" class="logout-btn">

                <i class="fa-solid fa-right-from-bracket"></i>

                <span>Logout</span>

            </a>

        </div>


    </header>



    <!-- =========================================
         MAIN PROFILE PAGE
    ========================================== -->

    <main class="profile-page">


        <!-- PAGE HEADER -->

        <section class="page-header">

            <div class="small-title">
                WELCOME TO OUR CAFE
            </div>

            <h1>My Profile</h1>

            <p>
                Manage your personal information and view your cafe activity.
            </p>

        </section>



        <!-- =====================================
             PROFILE LAYOUT
        ====================================== -->

        <div class="profile-layout">


            <!-- =================================
                 LEFT SIDEBAR
            ================================== -->

            <aside class="profile-sidebar">


                <!-- PROFILE AVATAR -->

                <div class="profile-avatar">

                    <i class="fa-solid fa-user"></i>

                </div>


                <h2>Lokesh</h2>

                <p class="profile-email">
                    lokesh@example.com
                </p>


                <!-- SIDE MENU -->

                <div class="side-menu">


                    <a href="#" class="active">

                        <i class="fa-solid fa-user"></i>

                        My Profile

                    </a>


                    <a href="history.html">

                        <i class="fa-solid fa-receipt"></i>

                        Order History

                    </a>


                    <a href="order-status.html">

                        <i class="fa-solid fa-clock-rotate-left"></i>

                        Live Orders

                    </a>


                    <a href="menu.html">

                        <i class="fa-solid fa-utensils"></i>

                        Browse Menu

                    </a>


                    <a href="logout.php">

                        <i class="fa-solid fa-right-from-bracket"></i>

                        Logout

                    </a>


                </div>


            </aside>



            <!-- =================================
                 RIGHT CONTENT
            ================================== -->

            <section class="profile-content">


                <!-- SECTION HEADER -->

                <div class="section-header">

                    <h2>Personal Information</h2>

                    <button
                        class="edit-btn"
                        id="editButton"
                        onclick="enableEditing()"
                    >

                        <i class="fa-solid fa-pen"></i>

                        Edit Profile

                    </button>

                </div>


                <form action="/myprofile" method="POST">
                    <div class="form-grid">


                        <!-- FULL NAME -->

                        <div class="form-group">

                            <label for="fullname">
                                Full Name
                            </label>

                            <input
                                type="text"
                                id="fullname"
                                value="Lokesh Konna"
                                disabled
                            >

                        </div>


                        <!-- EMAIL -->

                        <div class="form-group">

                            <label for="email">
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                value="lokesh@example.com"
                                disabled
                            >

                        </div>

                        <div class="form-group">

                            <label for="email">
                                Password
                            </label>

                            <input
                                type="password"
                                id="password"
                                value="********"
                                disabled
                            >

                        </div>

                    </div>
                </form>


                <!-- =================================
                     ACCOUNT STATISTICS
                ================================== -->

                <div class="stats">


                    <!-- ORDERS -->

                    <div class="stat">

                        <div class="stat-icon">

                            <i class="fa-solid fa-bag-shopping"></i>

                        </div>

                        <div>

                            <h3>12</h3>

                            <p>Total Orders</p>

                        </div>

                    </div>


                    <!-- BOOKINGS -->

                    <div class="stat">

                        <div class="stat-icon">

                            <i class="fa-solid fa-calendar-check"></i>

                        </div>

                        <div>

                            <h3>5</h3>

                            <p>Table Bookings</p>

                        </div>

                    </div>


                    <!-- FAVORITES -->

                    <div class="stat">

                        <div class="stat-icon">

                            <i class="fa-solid fa-heart"></i>

                        </div>

                        <div>

                            <h3>8</h3>

                            <p>Favorite Items</p>

                        </div>

                    </div>


                </div>



                

                <div
                    class="save-area"
                    id="saveArea"
                    style="display: none;"
                >

                    <button
                        class="save-btn"
                        onclick="saveProfile()"
                    >

                        <i class="fa-solid fa-check"></i>

                        Save Changes

                    </button>

                </div>


            </section>


        </div>


    </main>



    

