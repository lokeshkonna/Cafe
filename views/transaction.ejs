<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Payment - Our Cafe</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {

            font-family: "DM Sans", sans-serif;

            background: #f7f3ef;

            color: #40251f;

            min-height: 100vh;

        }


        /* =========================
           HEADER
        ========================= */

        .header {

            height: 70px;

            background: #40251f;

            color: white;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 7%;

        }


        .logo {

            display: flex;

            align-items: center;

            gap: 10px;

            font-family:
                "Playfair Display",
                serif;

            font-size: 24px;

            font-weight: 600;

        }


        .logo i {

            color: #d5a48d;

        }


        .secure {

            display: flex;

            align-items: center;

            gap: 7px;

            font-size: 13px;

            color: #ddd;

        }


        .secure i {

            color: #9bcf9b;

        }


        /* =========================
           MAIN
        ========================= */

        .payment-container {

            width: 90%;

            max-width: 1050px;

            margin: 45px auto;

        }


        .back {

            display: inline-flex;

            align-items: center;

            gap: 8px;

            text-decoration: none;

            color: #684035;

            font-size: 14px;

            margin-bottom: 25px;

        }


        .page-title {

            font-family:
                "Playfair Display",
                serif;

            font-size: 38px;

            margin-bottom: 8px;

        }


        .page-subtitle {

            color: #777;

            margin-bottom: 30px;

        }


        /* =========================
           PAYMENT GRID
        ========================= */

        .payment-grid {

            display: grid;

            grid-template-columns:
                1.5fr 1fr;

            gap: 25px;

        }


        .card {

            background: white;

            border-radius: 14px;

            padding: 28px;

            border: 1px solid #eee;

            box-shadow:
                0 8px 25px
                rgba(0, 0, 0, 0.06);

        }


        .card h2 {

            font-family:
                "Playfair Display",
                serif;

            font-size: 23px;

            margin-bottom: 25px;

        }


        /* =========================
           PAYMENT METHODS
        ========================= */

        .payment-methods {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 10px;

            margin-bottom: 25px;

        }


        .method {

            border: 1px solid #ddd;

            border-radius: 8px;

            padding: 14px 8px;

            text-align: center;

            cursor: pointer;

            background: white;

            transition: 0.3s;

        }


        .method i {

            display: block;

            font-size: 22px;

            margin-bottom: 7px;

            color: #684035;

        }


        .method span {

            font-size: 12px;

            font-weight: 600;

        }


        .method.active {

            border: 2px solid #684035;

            background: #faf4f0;

        }


        /* =========================
           FORM
        ========================= */

        .form-group {

            margin-bottom: 18px;

        }


        .form-group label {

            display: block;

            font-size: 13px;

            font-weight: 600;

            margin-bottom: 7px;

        }


        .input {

            width: 100%;

            height: 46px;

            border: 1px solid #ddd;

            border-radius: 7px;

            padding: 0 13px;

            font-size: 14px;

            outline: none;

        }


        .input:focus {

            border-color: #684035;

        }


        .form-row {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 15px;

        }


        /* =========================
           ORDER SUMMARY
        ========================= */

        .order-info {

            background: #faf7f4;

            border-radius: 10px;

            padding: 15px;

            margin-bottom: 20px;

        }


        .info-row {

            display: flex;

            justify-content: space-between;

            margin-bottom: 10px;

            font-size: 14px;

        }


        .info-row:last-child {

            margin-bottom: 0;

        }


        .item-list {

            margin: 20px 0;

        }


        .item {

            display: flex;

            justify-content: space-between;

            padding: 12px 0;

            border-bottom: 1px dashed #ddd;

            font-size: 14px;

        }


        .item-name {

            color: #555;

        }


        .item-price {

            font-weight: 600;

        }


        .total {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-top: 20px;

            padding-top: 18px;

            border-top: 2px solid #eee;

        }


        .total span:first-child {

            font-size: 15px;

            color: #777;

        }


        .total-price {

            font-size: 25px;

            font-weight: 700;

            color: #40251f;

        }


        /* =========================
           PAY BUTTON
        ========================= */

        .pay-btn {

            width: 100%;

            height: 52px;

            border: none;

            border-radius: 8px;

            background: #684035;

            color: white;

            font-size: 15px;

            font-weight: 700;

            cursor: pointer;

            margin-top: 20px;

            transition: 0.3s;

        }


        .pay-btn:hover {

            background: #4b2c25;

            transform: translateY(-2px);

        }


        .pay-btn i {

            margin-right: 8px;

        }


        .note {

            text-align: center;

            color: #888;

            font-size: 11px;

            margin-top: 12px;

        }


        /* =========================
           SUCCESS POPUP
        ========================= */

        .success-overlay {

            position: fixed;

            inset: 0;

            background:
                rgba(0, 0, 0, 0.55);

            display: none;

            align-items: center;

            justify-content: center;

            z-index: 100;

        }


        .success-box {

            width: 90%;

            max-width: 420px;

            background: white;

            border-radius: 16px;

            padding: 35px;

            text-align: center;

            box-shadow:
                0 20px 50px
                rgba(0, 0, 0, 0.2);

            animation:
                popup 0.3s ease;

        }


        @keyframes popup {

            from {

                opacity: 0;

                transform: scale(0.9);

            }

            to {

                opacity: 1;

                transform: scale(1);

            }

        }


        .success-icon {

            width: 75px;

            height: 75px;

            border-radius: 50%;

            margin: 0 auto 18px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #e8f5e9;

            color: #2e7d32;

            font-size: 35px;

        }


        .success-box h2 {

            font-family:
                "Playfair Display",
                serif;

            font-size: 28px;

            margin-bottom: 10px;

        }


        .success-box p {

            color: #777;

            font-size: 14px;

            line-height: 1.6;

        }


        .order-number {

            margin: 20px 0;

            padding: 12px;

            background: #faf4f0;

            border-radius: 8px;

            font-weight: 700;

            color: #684035;

        }


        .done-btn {

            width: 100%;

            height: 45px;

            border: none;

            border-radius: 7px;

            background: #684035;

            color: white;

            cursor: pointer;

            font-weight: 600;

        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 750px) {

            .payment-grid {

                grid-template-columns: 1fr;

            }

            .payment-methods {

                grid-template-columns:
                    repeat(3, 1fr);

            }

            .page-title {

                font-size: 31px;

            }

        }


        @media (max-width: 500px) {

            .header {

                padding: 0 5%;

            }

            .logo {

                font-size: 20px;

            }

            .secure {

                display: none;

            }

            .payment-container {

                width: 94%;

                margin-top: 25px;

            }

            .card {

                padding: 20px;

            }

            .form-row {

                grid-template-columns: 1fr;

            }

        }

    </style>

</head>


<body>


    <!-- HEADER -->

    <header class="header">

        <div class="logo">

            <i class="fa-solid fa-mug-hot"></i>

            Our Cafe

        </div>


        <div class="secure">

            <i class="fa-solid fa-lock"></i>

            Secure Payment

        </div>

    </header>


    <!-- MAIN -->

    <main class="payment-container">


        <a href="menu-item.html"
           class="back">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Menu

        </a>


        <h1 class="page-title">

            Complete Your Payment

        </h1>


        <p class="page-subtitle">

            Choose your payment method and complete your order.

        </p>


        <div class="payment-grid">


            <!-- PAYMENT -->

            <div class="card">

                <h2>Payment Method</h2>


                <div class="payment-methods">


                    <div class="method active"
                         onclick="selectMethod(this)">

                        <i class="fa-regular fa-credit-card"></i>

                        <span>Card</span>

                    </div>


                    <div class="method"
                         onclick="selectMethod(this)">

                        <i class="fa-solid fa-mobile-screen-button"></i>

                        <span>UPI</span>

                    </div>


                    <div class="method"
                         onclick="selectMethod(this)">

                        <i class="fa-solid fa-building-columns"></i>

                        <span>Net Banking</span>

                    </div>


                </div>


                <div class="form-group">

                    <label>
                        Cardholder Name
                    </label>

                    <input
                        type="text"
                        class="input"
                        placeholder="Enter cardholder name">

                </div>


                <div class="form-group">

                    <label>
                        Card Number
                    </label>

                    <input
                        type="text"
                        class="input"
                        placeholder="1234 5678 9012 3456"
                        maxlength="19">

                </div>


                <div class="form-row">


                    <div class="form-group">

                        <label>
                            Expiry Date
                        </label>

                        <input
                            type="text"
                            class="input"
                            placeholder="MM / YY"
                            maxlength="5">

                    </div>


                    <div class="form-group">

                        <label>
                            CVV
                        </label>

                        <input
                            type="password"
                            class="input"
                            placeholder="•••"
                            maxlength="3">

                    </div>


                </div>


                <button
                    class="pay-btn"
                    onclick="makePayment()">

                    <i class="fa-solid fa-lock"></i>

                    Pay ₹360

                </button>


                <p class="note">

                    This is a demo payment page.
                    No real money will be charged.

                </p>

            </div>


            <!-- ORDER SUMMARY -->

            <div class="card">

                <h2>Order Summary</h2>


                <div class="order-info">

                    <div class="info-row">

                        <span>
                            Table
                        </span>

                        <strong>
                            #5
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            Order Type
                        </span>

                        <strong>
                            Dine In
                        </strong>

                    </div>

                </div>


                <div class="item-list">


                    <div class="item">

                        <span class="item-name">

                            Cappuccino × 2

                        </span>

                        <span class="item-price">

                            ₹240

                        </span>

                    </div>


                    <div class="item">

                        <span class="item-name">

                            Samosa × 3

                        </span>

                        <span class="item-price">

                            ₹120

                        </span>

                    </div>


                </div>


                <div class="total">

                    <span>
                        Total Amount
                    </span>

                    <span class="total-price">
                        ₹360
                    </span>

                </div>

            </div>

        </div>

    </main>


    <!-- SUCCESS POPUP -->

    <div
        class="success-overlay"
        id="successOverlay">


        <div class="success-box">


            <div class="success-icon">

                <i class="fa-solid fa-check"></i>

            </div>


            <h2>
                Payment Successful!
            </h2>


            <p>

                Your order has been placed successfully.

                <br>

                Thank you for ordering from Our Cafe!

            </p>


            <div class="order-number">

                Order ID: #CAF20260831001

            </div>


            <div style="display:flex; gap:12px; margin-top:20px; justify-content:center;">
                <button
                    class="done-btn"
                    style="background:#33210d; flex:1;"
                    onclick="window.location.href='customer_order_status.html'">
                    <i class="fa-solid fa-clock-rotate-left"></i> Track Live Order
                </button>
                <button
                    class="done-btn"
                    style="background:#684035; flex:1;"
                    onclick="goToOrders()">
                    View History
                </button>
            </div>


        </div>

    </div>


    <script>


        /* =========================
           PAYMENT METHOD
        ========================= */

        function selectMethod(element) {

            const methods =
                document.querySelectorAll(".method");

            methods.forEach(method => {

                method.classList.remove("active");

            });

            element.classList.add("active");

        }


        /* =========================
           DEMO PAYMENT
        ========================= */

        function makePayment() {

            const button =
                document.querySelector(".pay-btn");


            button.innerHTML =
                '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';


            button.disabled = true;


            setTimeout(() => {

                document
                    .getElementById("successOverlay")
                    .style.display = "flex";


                button.innerHTML =
                    '<i class="fa-solid fa-check"></i> Payment Completed';


            }, 1800);

        }


        /* =========================
           PREVIOUS ORDERS
        ========================= */

        function goToOrders() {

            window.location.href =
                "previous-orders.html";

        }

    </script>


</body>

</html>